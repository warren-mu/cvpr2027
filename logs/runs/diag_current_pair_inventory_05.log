def logged_artifact(run_path, marker, expected, *, field=None):
    data, reference = audited(run_path)
    if data['_meta']['exit_code'] != 0 or data['metrics']['command_exit_code'] != 0:
        raise ValueError('Artifact producer failed: ' + run_path)
    values = [json.loads(line[len(marker):]) for line in (ROOT / data['_meta']['log_path']).read_text().splitlines()
              if line.startswith(marker)]
    if len(values) != 1 or (values[0] if field is None else values[0][field]) != expected:
        raise ValueError('Artifact differs from exact logged publication')
    return data, reference, values[0]

