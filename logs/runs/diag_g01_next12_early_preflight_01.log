from pathlib import Path
from src.tools.t01_partition import audited_result,sha_file
from src.tools import merge_pair_v2 as merge
from src.envs.pair_v2_stable import position_step,exceeded,PREFLIGHT_POLICY
ROOT=merge.ROOT.resolve()
NAME='diag_g01_next12_early_preflight_01'
assert os.environ['CVPR_RUN_NAME']==NAME
def read(ref):
 p=merge.reference_path(ref,root=ROOT); return json.loads(p.read_bytes())
output={'scope':'Existing ended sources only; original preflight measurements rechecked against original native action metadata; no new rendering, thresholds or acceptance','sources':[]}
for number in (8,9,205):
 name=f'gen_train_next12_60_01_retry1_c6_floorplan{number}'
 data,ref=audited_result(ROOT/'results'/f'{name}.json'); m=data['metrics']
 assert data['_meta']['end'] and m['final_metrics_verified'] is True and m['terminal_verified_after_cleanup'] is True
 journal=ROOT/data['config']['attempt_journal']; assert sha_file(journal)==m['attempt_journal_sha256']
 rows=[json.loads(line) for line in journal.read_text().splitlines() if line.strip()]
 assert len(rows)==m['attempts']
 out={'source':ref,'start':data['_meta']['start'],'end':data['_meta']['end'],'status':m['status'],'attempts':m['attempts'],'passed_by_class':m['passed_by_class'],'scene_excluded':m['scene_excluded'],'search_stop_reason':m['search_stop_reason'],'pool_catalog_count':len(m['pool_catalogs']),'proposal_trials':m['proposal_trials'],'discovery_failures':m['discovery_failures'],'placement_exhausted_proposals':m['placement_exhausted_proposals'],'cleanup_errors':m['cleanup_errors'],'journal':{'file':str(journal.relative_to(ROOT)),'sha256':sha_file(journal)},'visits':[]}
 for visit in m['controller_visits']:
  pf=read(visit['preflight_reference']); index=read(visit['raw_index'])
  indexed={(str(Path(r['file']).resolve()),r['sha256']) for r in index['files']}
  for rawref in index['files']: merge.reference_path(rawref,root=ROOT)
  assert (str(Path(visit['preflight_reference']['file']).resolve()),visit['preflight_reference']['sha256']) in indexed
  assert pf['policy']==PREFLIGHT_POLICY and pf['passed']==visit['preflight_passed']
  diag=pf['diagnostics']; source=diag['source_snapshot']; original=source['objects']
  source_payload=read(source['reference']); assert source_payload['objects']==original
  objects={obj['name']:obj for obj in original}
  steps=[{'index':'pause','action_reference':diag['pause_action_reference'],'measurements':diag['pause_measurements']}]+diag['initial_settling']['observations']
  previous=original; travelled={}; records=[]; offending={}
  for step in steps:
   action_ref=step['action_reference']; assert (str(Path(action_ref['file']).resolve()),action_ref['sha256']) in indexed
   action=read(action_ref); assert action['exception'] is None and action['after_metadata']['lastActionSuccess'] is True
   measured=position_step(previous,action['after_metadata']['objects'],original,travelled)
   assert measured==step['measurements']
   assert action['action']==('PausePhysicsAutoSim' if step['index']=='pause' else 'AdvancePhysicsStep')
   if step['index']!='pause': assert action['arguments']=={'timeStep':0.02,'simSeconds':0.1,'allowAutoSimulation':False}
   names=exceeded(measured,PREFLIGHT_POLICY['initial_displacement_max_m'])
   records.append({'index':step['index'],'action':action['action'],'action_reference':action_ref,'inventory_exact':measured['inventory_exact'],'missing_names':measured['missing_names'],'added_names':measured['added_names'],'over_limit_names':names,'native_is_scene_at_rest':action['after_metadata'].get('isSceneAtRest')})
   current={obj['name']:obj for obj in action['after_metadata']['objects']}
   for name in names:
    offending.setdefault(name,{'object_metadata':{k:objects[name].get(k) for k in ('name','objectType','pickupable','moveable','parentReceptacles','position','rotation')},'observations':[]})['observations'].append({'index':step['index'],'measurement':measured['objects'][name],'current_parentReceptacles':current[name].get('parentReceptacles'),'current_isMoving':current[name].get('isMoving')})
   previous=action['after_metadata']['objects']; travelled={name:row['observed_path_length_m'] for name,row in measured['objects'].items()}
  out['visits'].append({'controller_id':visit['controller_id'],'preflight_reference':visit['preflight_reference'],'raw_index':visit['raw_index'],'all_indexed_files_SHA_verified':True,'recorded_compact':visit['preflight_measurements'],'preflight_passed':pf['passed'],'preflight_reasons':pf['reasons'],'preflight_error':pf['error'],'original_snapshot_reference':source['reference'],'all_initial_measurements_match_original_native_metadata':True,'steps':records,'offending_objects':offending,'stable_baseline_created':pf['snapshot'] is not None,'stability_window_completed':diag['stability_window']['completed']})
 output['sources'].append(out)
