++      "\"\"\"One-off immutable config split; no source revalidation, run, or result output.\n\nThe root agent may inline these exact bytes through run_logged + record_command.\nCVPR_CONFIG_PREPARATION_ROOT is only a local-draft destination override; on Hopper\nomit it and run from the repository. The original parent still authenticates the\ncount basis before generation. This script does not grant scientific acceptance.\n\"\"\"\nimport copy\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\n\nSOURCE = {\n    'file': 'configs/gen_test_config_round2_40_01_retry2_quota.json',\n    'sha256': '80e2fec4ad9a6e472fe9d8498aa93d0026c89260036f01d1ee2bce154819012b',\n}\nSIZES = (6, 6, 6, 6, 6, 6, 4)\nKINDS = ('direct_flip', 'direct_stay', 'look_flip', 'look_stay')\n\n\ndef require(condition, message):\n    if not condition:\n        raise ValueError(message)\n\n\ndef encode(value):\n    return (json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + '\\n').encode()\n\n\ndef sha(raw):\n    return hashlib.sha256(raw).hexdigest()\n\n\ndef prepare(root):\n    root = Path(root).resolve()\n    original_path = root / SOURCE['file']\n    require(not original_path.is_symlink(), 'Original plan cannot be a symlink')\n    original_bytes = original_path.read_bytes()\n    require(sha(original_bytes) == SOURCE['sha256'], 'Original plan bytes changed')\n    original = json.loads(original_bytes)\n    require(original['version'] == 'g01_static_configuration_tickets_v2'\n            and original['partition'] == 'test'\n            and original['parent_run_name'] == 'gen_test_config_round2_40_01_retry2'\n            and original['count_basis_authority'] == 'g01_published_independent_checkpoint_receipt_v1'\n            and original['outstanding_reservations'] == []\n            and 'shared_ticket_bank' not in original,\n            'Require the original standalone configuration-counting plan')\n    require(original['field_of_view'] == 60 and original['seed'] == 0\n            and original['scene_concurrency'] == 6 and original['cpu_cores_per_gpu'] == 12\n            and original['targets'] == dict.fromkeys(KINDS, 60)\n            and original['count_stage'] == 'independent_unique_construction_before_T02_filtering',\n            'Original settings differ from the approved immutable cutoff')\n    expected_scenes = [f'FloorPlan{offset + number}' for number in range(21, 31)\n                       for offset in (0, 200, 300, 400)]\n    assignments = original['assignments']\n    require([row['scene'] for row in assignments] == expected_scenes,\n            'Require all original40 interleaved scene assignments exactly once')\n    for row in assignments:\n        limits = row['actual_output_caps']\n        require(set(limits) == set(KINDS)\n                and all(type(limits[kind]) is int and limits[kind] >= 0 for kind in KINDS),\n                'Original scene tickets must be nonnegative integers')\n        require(row['allowed_kinds'] == [kind for kind in KINDS if limits[kind] > 0],\n                'Original allowed classes differ from the preserved tickets')\n        for kind in KINDS:\n            existing = original['confirmed_by_scene'].get(row['scene'], {}).get(kind, 0)\n            require(limits[kind] + existing <= 6, 'Original aggregate scene/class limit exceeds6')\n    for kind in KINDS:\n        require(sum(row['actual_output_caps'][kind] for row in assignments)\n                <= max(0, 60 - original['confirmed_by_kind'][kind]),\n                'Original whole40 allocation exceeds global remaining capacity')\n\n    products, slices, flattened = [], [], []\n    cursor = 0\n    for index, size in enumerate(SIZES, 1):\n        name = f'gen_test_s16_round2_s{index:02d}'\n        indices = list(range(cursor, cursor + size))\n        selected = copy.deepcopy(assignments[cursor:cursor + size])\n        value = copy.deepcopy(original)\n        value.update(parent_run_name=name, assignments=selected)\n        require({key: item for key, item in value.items() if key not in ('parent_run_name', 'assignments')}\n                == {key: item for key, item in original.items() if key not in ('parent_run_name', 'assignments')},\n                'Only the technical parent name and disjoint assignment subset may change')\n        flattened.extend(selected)\n        file = f'configs/{name}_quota.json'\n        raw = encode(value)\n        ref = {'file': file, 'sha256': sha(raw)}\n        command = ['python3', '-u', '-m', 'src.tools.g01_collect_parallel',\n                   '--name', name, '--scenes', *[row['scene'] for row in selected],\n                   '--concurrency', '6', '--benchmark-source', 'results/gen_train_concurrency_s15_02.json',\n                   '--timeout-seconds', '1600', '--partition', 'test',\n                   '--quota-plan', file, '--quota-plan-sha256', ref['sha256'], '--nearby-physics']\n        slices.append({'parent_run_name': name, 'quota_reference': ref,\n                       'original_assignment_indices_zero_based': indices,\n                       'scenes': [row['scene'] for row in selected], 'command': command})\n        products.append((file, raw))\n        cursor += size\n    require(cursor == len(assignments) and flattened == assignments\n            and len({row['scene'] for row in flattened}) == len(assignments),\n            'The seven slices must partition the original assignments exactly once')\n    require(len({item['parent_run_name'] for item in slices}) == len(SIZES), 'Repeated technical parent name')\n    mapping = {\n        'version': 'g01_s16_standalone_fixed40_config_split_v1',\n        'original_plan_reference': SOURCE,\n        'count_basis_sources': copy.deepcopy(original['count_basis_sources']),\n        'scope': 'Non-result standalone configuration preparation only; original published count basis and assigned tickets preserved; not source or T02 acceptance.',\n        'slices': slices,\n        'execution_requirements': {\n            'original_smoke_does_not_enter_quota': True,\n            'each_assignment_may_be_submitted_once': True,\n            'failed_nonblack_slice_must_not_be_reissued_as_fresh_full_tickets': True,\n            'newly_accepted_configuration_cutoff_requires_a_new_authenticated_plan': True,\n            'original_count_basis_authenticated_again_by_parent': True,\n            'shared_queue_claim_required': False,\n            'shared_training_queue_unchanged': True,\n            'gpus': 1, 'cpu_cores': 12, 'concurrency': 6,\n            'nearby_physics_explicit_opt_in': True,\n            'proposal_priority': ['look_stay', 'look_flip', 'direct_flip', 'direct_stay'],\n        },\n        'timing': {\n            'scene_grant_seconds': 1200,\n            'parent_required_timeout_seconds': 1600,\n            'requested_pbs_wall_seconds_if_approved': 1630,\n            'requested_pbs_walltime_if_approved': '00:27:10',\n            'formula': '120 benchmark authentication + 120 gate + 10 gate wrapper + 1*(1200 scene + 60 child finalization) + 30 stage finalization + 60 parent cleanup; PBS +30',\n            'basis': 'Existing exact entry engineering upper bound for one <=6-scene wave; NOT observed supplement16 runtime or a measured runtime multiplied by1.3.',\n            'budget_and_walltime_confirmation_pending': True,\n        },\n        'gpu_submission_performed': False,\n        'scientific_counts_recomputed': False,\n    }\n    mapping_file = 'configs/g01_s16_round2_standalone_split.json'\n    products.append((mapping_file, encode(mapping)))\n    for file, _ in products:\n        path = root / file\n        require(not path.exists() and not path.is_symlink(), 'Preserve existing artifact: ' + file)\n        require(path.parent == root / 'configs' and path.parent.is_dir(), 'Require the existing repository configs directory')\n    references = []\n    for file, raw in products:\n        path = root / file\n        with path.open('xb') as stream:\n            stream.write(raw)\n        path.chmod(0o444)\n        references.append({'file': file, 'sha256': sha(raw)})\n    require(original_path.read_bytes() == original_bytes, 'Original plan changed during preparation')\n    print('G01_S16_STANDALONE_CONFIGS_JSON: ' + json.dumps({\n        'original_plan_reference': SOURCE, 'artifacts': references,\n        'scope': mapping['scope'], 'gpu_submission_performed': False,\n        'scientific_counts_recomputed': False}, sort_keys=True, allow_nan=False))\n\n\nif __name__ == '__main__':\n    prepare(os.environ.get('CVPR_CONFIG_PREPARATION_ROOT', os.getcwd()))\n"
