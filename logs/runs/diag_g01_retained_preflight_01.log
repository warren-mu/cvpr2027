from pathlib import Path
from src.tools import merge_pair_v2 as merge
from src.tools.t01_partition import audited_result
from src.tools.t01v2_posthoc_solvability import verified_passed_rows
rows=[]; selected=[]
def check(ref, root):
 try:
  p=merge.reference_path(ref,within=root)
  if "bytes" in ref and p.stat().st_size!=ref["bytes"]:raise ValueError("Byte length mismatch")
  return {"reference":ref,"sha_verified":True}
 except Exception as e:return {"reference":ref,"sha_verified":False,"error":type(e).__name__+": "+str(e)}
for path in sorted((merge.ROOT/"results").glob("gen_train_concurrency_s15_02_c*_floorplan*.json")):
 out={"source_file":str(path.relative_to(merge.ROOT)),"selected_for_full_original_checkpoint":False}
 rows.append(out)
 try:
  data,ref=audited_result(path); m=data["metrics"]; c=data["config"]; raw=Path(c["raw_evidence_dir"])
  eligibility,journal,passed=verified_passed_rows(data)
  out.update(source_reference=ref,source_status=m.get("status"),reported_passed_by_class=m.get("passed_by_class"),eligibility=eligibility,journal=journal,original_final_preflight=check(m.get("scene_preflight_reference"),raw))
  visits={}
  for visit in m.get("controller_visits",[]):
   cid=visit["controller_id"]
   if cid in visits:raise ValueError("Duplicate original Controller")
   visits[cid]={"preflight":check(visit.get("preflight_reference"),raw),"index":check(visit.get("raw_index"),raw),"initial_setup":check(visit.get("initial_agent_setup_reference"),raw)}
  out["original_controller_artifacts"]=visits
  proofs=[]
  for compact,pairref,pairpath in passed:
   pair=merge.read_reference(pairref,within=pairpath.parent)
   cid=pair["search_controller_id"]; visit=visits[cid]
   checked=all(v["sha_verified"] for v in visit.values())
   proofs.append({"pair_id":pair["pair_id"],"kind":pair["kind"],"pair_reference":pairref,"controller_id":cid,"controller_artifacts_sha_verified":checked})
  out["candidate_controller_bindings"]=proofs
  ready=bool(proofs) and eligibility["eligible"] and out["original_final_preflight"]["sha_verified"] and all(p["controller_artifacts_sha_verified"] for p in proofs)
  out["selected_for_full_original_checkpoint"]=ready
  if ready:selected.append(str(path.relative_to(merge.ROOT)))
 except Exception as e:out["error"]=type(e).__name__+": "+str(e)
print("G01_RETAINED_PREFLIGHT_JSON: "+json.dumps({"scope":"Original references only; no files rebuilt, no scientific acceptance implied; unused Controller index loss does not erase a complete used Controller","sources":rows,"selected_sources":selected},sort_keys=True,allow_nan=False),flush=True)

