# run_logged: python3 -m src.tools.record_command --name diag_pilot_T0_retry4_first_update_01 -- python3 -c from pathlib import Path
import hashlib,json
p=Path('logs/runs/smoke_e2e_pilot_T0_s0_01_retry4/ppo/update_001.jsonl')
