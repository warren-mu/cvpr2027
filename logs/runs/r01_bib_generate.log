FINAL_METRICS_JSON: {"conference_source_unavailable_keys": ["gae2016"], "entries": [{"attempts": [{"kind": "bibtex", "status": "parsed_title_matched", "url": "https://proceedings.neurips.cc/paper_files/paper/28640-/bibtex"}], "entry": {"fields": {"author": "Wang, Kangrui and Zhang, Pingyue and Wang, Zihan and Gao, Yaning and Li, Linjie and Wang, Qineng and Chen, Hanyang and Lu, Yiping and Yang, Zhengyuan and Wang, Lijuan and Krishna, Ranjay and Wu, Jiajun and Li, Fei-Fei and Choi, Yejin and Li, Manling", "booktitle": "Advances in Neural Information Processing Systems", "doi": "10.52202/085713-5754", "editor": "D. Belgrave and C. Zhang and H. Lin and R. Pascanu and P. Koniusz and M. Ghassemi and N. Chen", "pages": "172871--172933", "publisher": "Curran Associates, Inc.", "title": "VAGEN: Reinforcing World Model Reasoning for Multi-Turn VLM Agents", "url": "https://proceedings.neurips.cc/paper_files/paper/2025/file/fc6688d75adde86b9df910769c1d02e3-Paper-Conference.pdf", "volume": "38, Main Conference", "year": "2025"}, "hash": "4b80d2d6718f", "key": "vagen2025", "type": "inproceedings"}, "key": "vagen2025", "preferred_source_used": true, "selected": {"kind": "bibtex", "url": "https://proceedings.neurips.cc/paper_files/paper/28640-/bibtex"}, "source_sha256": "bb982c7fe26c02d42e068c0682deba8233022be3dd40b28e4dab48db8a15ddb5", "status": "generated"}, {"attempts": [{"kind": "html_bibtex", "status": "parsed_title_matched", "url": "https://proceedings.mlr.press/v306/li26bj.html"}], "entry": {"fields": {"abstract": "To navigate partially observable visual environments, recent VLM agents increasingly internalize world modeling capabilities directly into their policies via explicit CoT reasoning with reinforcement learning (RL). However, mere passive exploitation of reasoning on visited states is insufficient for sparse-reward agentic tasks, as it lacks the epistemic drive to actively uncover the known unknown required for robust generalization. We ask: Can VLM agents actively find signals that challenge and update their internal world model through curiosity-driven exploration? In this work, we propose GLANCE, a unified framework that bridges reasoning and exploration by grounding the agent’s linguistic world model into the stable visual representations of an evolving target network. Crucially, GLANCE leverages the discrepancy between linguistic prediction and visual reality as an intrinsic curiosity signal within reinforcement learning, steering the agent to actively explore areas where its internal model is uncertain. Extensive experiments across a series of agentic tasks show the effectiveness of GLANCE, and demonstrate that aligning what the agent thinks with what the agent sees is key to solving complex or sparse agentic tasks.", "author": "Li, Haoxi and Hou, Qinglin and Ma, Jianfei and Lai, Jinxiang and Han, Tao and Bai, Sikai and Guo, Jingcai and Zhang, Jie and Guo, Song", "booktitle": "Proceedings of the 43rd International Conference on Machine Learning", "editor": "Zhang, Tong and Dudik, Miroslav and Jaggi, Martin and Agarwal, Alekh and Li, Sharon and Schuurmans, Dale and Zhu, Jerry and Berkenkamp, Felix and Dong, Hanze and Bietti, Alberto", "month": "06--11 Jul", "pages": "67405--67430", "pdf": "https://raw.githubusercontent.com/mlresearch/v306/main/assets/li26bj/li26bj.pdf", "publisher": "PMLR", "series": "Proceedings of Machine Learning Research", "title": "What You Think is What You See: Driving Exploration in {VLM} Agents via Visual-Linguistic Curiosity", "url": "https://proceedings.mlr.press/v306/li26bj.html", "volume": "306", "year": "2026"}, "hash": "b79b0f2a9700", "key": "glance2026", "type": "inproceedings"}, "key": "glance2026", "preferred_source_used": true, "selected": {"kind": "html_bibtex", "url": "https://proceedings.mlr.press/v306/li26bj.html"}, "source_sha256": "adeddc83ed41eb3325a78f9ed32924892354cac65a7b90fc12932200a0cd1be0", "status": "generated"}, {"attempts": [{"kind": "arxiv_atom", "status": "parsed_titl