rce': reference, 'receipt': receipt, 'gate': gate_ref,\n               'original_metrics': copy.deepcopy(metrics), 'black_guard': None}\n    if item.get('black_guard') is not None:\n        proof, proof_ref = ended(item['black_guard'])\n        pm = proof['metrics']\n        require(meta['exit_code'] == 86 and gate['_meta']['exit_code'] == 86\n                and metrics.get('black_frame_detected') is True and metrics.get('units') == []\n                and metrics.get('cleanup_errors') == [] and metrics.get('errors') == []\n                and metrics.get('unstarted_unit_indices') == list(range(6))\n                and proof['_meta']['exit_code'] == 0 and pm.get('eligible_for_same_manifest_retry') is True\n                and pm.get('job_id') == job and pm.get('units_started') == 0\n                and pm.get('node') == cfg['node'] and pm.get('gpu_uuid') == cfg['cuda_visible_devices']\n                and any(same_ref(s, reference) for s in proof.get('sources', []))\n                and any(same_ref(s, gate_ref) for s in proof.get('sources', [])),\n                'Earlier attempt is not the original authenticated zero-start black retry')\n        verified_guard_sources = []\n        for original in proof['sources']:\n            _, actual = ended(original['file'])\n            require(same_ref(original, actual) and original.get('metrics_sha256') == actual['metrics_sha256'],\n                    'Original black-guard evidence changed')\n            verified_guard_sources.append(actual)\n        history['black_guard'] = proof_ref\n        history['black_guard_sources'] = verified_guard_sources\n    else:\n        require(meta['exit_code'] in (0, 1) and gate['_meta']['exit_code'] == 0\n                and metrics.get('black_frame_detected') is False\n                and metrics.get('all_units_ended') is True and metrics.get('unstarted_unit_indices') == []\n                and metrics.get('cleanup_errors') == [] and metrics.get('errors') == []\n                and sor