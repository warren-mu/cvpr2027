ized': False}\n    if measured['export_checks_complete'] and row and row['status'] == 'rejected':\n        require(bool(row.get('rejection_reasons')), 'Rejected export lacks original reasons')\n        result['membership'] = 'measured_export_rejection_before_fixed_cache_population'\n    elif (measured['export_checks_complete'] and row and row['status'] == 'exported'\n          and row.get('table_complete') is True and row.get('native_evidence_verified') is True\n          and row.get('pair_checks_passed') is True and row.get('error') is None\n          and not row.get('raw_index_error') and row.get('cleanup_errors') == []):\n        pair_dir = Path(row['scratch_directory']).resolve()\n        table = cache.read_json_ref(row['table_manifest'], pair_dir, expected=pair_dir / 'table/table.json')\n        details = cache.read_json_ref(row['detail'], pair_dir, expected=pair_dir / 'checks.json')\n        require(details.get('table_manifest') == row['table_manifest']\n                and table.get('dataset_identity') == identity_fields(entry['pair_id'], entry['pair'])\n                and table.get('pair_id') == entry['pair_id'] and table.get('scene') == entry['scene']\n                and isinstance(table.get('states'), dict) and table['states'], 'Exact original table identity differs')\n        result.update(membership='export_complete_pending_formal_cache_reverification',\n                      table_manifest=row['table_manifest'], details=row['detail'],\n                      dataset_identity=table['dataset_identity'], stored_state_count=len(table['states']))\n    return result\n\n\ndef main():\n    spec = json.loads(sys.argv[1])\n    require(spec.get('ready_to_freeze') is True, 'Draft: fill all actual terminal histories before executing')\n    first_batch = spec.get('first_batch', 1)\n    require(type(first_batch) is int and first_batch in (1, 5, 9), 'Only the three explicitly planned fixed cutoffs are supported')\n    suffix = 'remaining24' if first_batch == 1 else 't