try['proposal_identity'] not in proposal_ids, 'Repeated source/proposal or overlap with certified first-five')\n            keys.add(key)\n            proposal_ids.add(entry['proposal_identity'])\n        attempts = group['attempts']\n        require(attempts and attempts[-1]['name'] == group.get('first_complete_nonblack_name')\n                and attempts[-1].get('black_guard') is None, 'No explicit first complete nonblack endpoint')\n        previous_job, group_history = None, []\n        for attempt_index, item in enumerate(attempts):\n            expected_name = base + ('_retry%d' % attempt_index if attempt_index else '')\n            require(item['name'] == expected_name and (attempt_index == len(attempts) - 1\n                    or item.get('black_guard') is not None), 'Retry chain omitted or replaced an earlier attempt')\n            parent, parent_ref, history = parent_attempt(item, group, entries, previous_job)\n            group_history.append(history)\n            previous_job = item['job_id']\n        histories.append({'manifest': group['manifest'], 'attempts': group_history})\n        require(same_ref(group.get('first_complete_nonblack_reference'), parent_ref),\n                'Explicit first complete nonblack result bytes changed')\n        for record in sorted(parent['metrics']['units'], key=lambda x: x['unit_index']):\n            rows.append(unit_row(parent, parent_ref, record, entries[record['unit_index']]))\n    require(len(rows) == 24, 'Full attempted cutoff was not accounted for')\n    usable = [row for row in rows if row['membership'] == 'export_complete_pending_formal_cache_reverification']\n    classes = ('direct_flip', 'direct_stay', 'look_flip', 'look_stay')\n    require(all(row['entry'].get('kind') in classes for row in rows), 'Unexpected source class')\n    seconds = math.ceil(686.2 * 1.3 * len(usable) / 5)\n    requested_states = sum(row['stored_state_count'] for row in usable)\n    blocked = []\n    if not usable or requested_states 