   scene=assignment['scene'];child=parent+'_c6_'+scene.lower();row={'name':child,'scene':scene,'job_id':owner['job_id'],'claim_reference':original['claim_reference'],'source_reported_counts':None,'independent_acceptance':None}
   log=ROOT/'logs/runs'/(child+'.log');row['log_exists']=log.is_file()
   if log.is_file():
    with log.open('rb') as f:head=f.read(4096).decode(errors='replace')
    row['original_log_header']=head.splitlines()[:5]
   p=ROOT/'results'/(child+'.json');row['result_exists']=p.is_file()
   if p.is_file():
    raw=p.read_bytes();data=json.loads(raw);m=data.get('metrics',{});row.update(source_reference=archive(raw,evidence,child+'_result.json'),meta={k:data.get('_meta',{}).get(k) for k in ('start','end','exit_code')},original_metrics={k:m.get(k) for k in ('status','error','errors','attempts','passed_by_class','black_frame_detected','cleanup_errors','scene_excluded')})
