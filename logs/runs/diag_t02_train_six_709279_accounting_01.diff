 'Not the original G01 native collection entry')\n        expected = ['python3','-u','-m','src.tools.g01_collect_parallel','--name',name,'--scenes',*c['scenes'],\n                    '--concurrency','6','--benchmark-source',c['benchmark_source'],'--timeout-seconds',str(expected_timeout),'--partition','test',\n                    '--quota-plan', old_plan_ref['file'], '--quota-plan-sha256', old_plan_ref['sha256']]\n        require(argv == expected and c['concurrencies'] == [6] and c['timeout_seconds'] == expected_timeout\n                and c.get('g01_partition') == 'test' and c.get('per_scene_class_cap') == 6\n                and c['submission']['file'] == str(pp.relative_to(ROOT)) and c['submission']['sha256'] == watch.digest(pp),\n                'G01 original command/submission identity differs')\n        require(m['kind'] == 'g01_parallel_collection' and m['status'] == 'blocked_by_render_gate'\n                and m['exit_code'] == 86 and m['black_frame_detected'] is True and m['cleanup_errors'] == []\n                and m['scene_runs'] == [] and m['started_shards'] == [] and m['stages'] == []\n                and m['admission_final'] == [] and m['unfinished_run_names'] == [] and m['stop_reasons'] == []\n                and not m.get('error') and not m.get('errors') and m['acceptance_passed'] is False,\n                'G01 has work/non-black errors or uncertain cleanup')\n        gate_name = name + '_j' + job.replace('.', '_').replace('-', '_') + '_gate'\n        require(m['gate']['run_name'] == gate_name and m['gate']['exit_code'] == 86\n                and not m['gate'].get('provenance_error') and m['gate']['result_path'] == 'results/' + gate_name + '.json',\n                'G01 gate wrapper is not the exact failed native gate')\n        gate_ref = m['gate']['source']\n        gate_timeout = c['gate_timeout_seconds']\n        mask, cpu = c['parent_cuda_visible_devices'], c['cpu_affinity']\n        checked_results = [outer_ref]\n\n    gate, audit_ref = logged(gate_name)\n    bind(gate_ref, gate, ROOT / 'results' / (gate_name + '.json'))\n    g, a, gm = gate['config'], gate['config']['allocation'], gate['metrics']\n    nodes = {part.split('/')[0] for part in fields['exec_host'].split('+')}\n    require(nodes == {c['node']} == {g['node']} == {outer['_meta']['host']} == {inner['_meta']['host']} == {gate['_meta']['host']},\n            'Actual PBS node does not match every producer and gate')\n    require(g['name'] == gate_name and g['pbs_jobid'] == job and a['pbs_jobid'] == job\n            and a['name'] == gate_name and a['cuda_visible_devices'] == mask and a['cuda_driver_uuids'] == [mask]\n            and a['cpu_affinity'] == cpu and len(cpu) == len(set(cpu)) == 12\n            and a['scratch'] == payload['environment']['CVPR_SCRATCH']\n            and g['resolution'] == 255 and g['segmentation'] is True\n            and g['timeout_seconds'] == gate_timeout, 'Native gate allocation/mask/CPU/scratch mismatch')\n    command = gate['_meta']['command']\n    gate_arguments = ['-u','-m','src.tools.render_gate','--name',gate_name,'--gpus','1',\n                      '--resolution','255','--segmentation','--timeout-seconds']\n    require(Path(command[0]).name == 'python3' and command[1:-1] == gate_arguments\n            and command[-1] in (str(float(gate_timeout)), str(int(gate_timeout))),\n            'Native gate command differs')\n    require(gate['_meta']['exit_code'] == 86 and gm['exit_code'] == 86 and gm['passed'] is False\n            and gm['black_frame_detected'] is True and gm['errors'] == [] and gm['cleanup_errors'] == []\n            and gm['expected_gpu_count'] == gm['completed_gpu_count'] == 1\n            and len(gm['devices']) == len(a['devices']) == 1, 'Gate is not a complete clean one-GPU black stop')\n    device, row = a['devices'][0], gm['devices'][0]\n    obs = row['observation']\n    require(device['logical_index'] == 0 and device['gpu_uuid'] == mask and row['worker_error'] is None\n            and obs['gp