+  "config": {
+    "command": [
+      "python3",
+      "-c",
+      "\"\"\"One-off reading of the completed original certificate; no native re-render or new authorization.\n\nRun through run_logged + record_command, only after the fixed-population cache\nproducer ends. Original source/native science is not repeated on the login node.\n\"\"\"\nimport signal\n\n\ndef deadline(signum, frame):\n    raise TimeoutError('Certificate summary exceeded the 12-second metadata limit')\n\n\nsignal.signal(signal.SIGALRM, deadline)\nsignal.setitimer(signal.ITIMER_REAL, 12)\n\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nfrom src.tools.t01_partition import audited_result, canonical_hash\nfrom src.tools import t02_cache_check as cache\nfrom src.envs.pair_table_cache import require_cache_validation\n\nROOT = Path.cwd().resolve()\nPARENTS = ('t02_export_train_six_01_retry3', 't02_export_train_six_02_retry2',\n           't02_export_train_six_03', 't02_export_train_six_04')\nSOURCES = ['results/' + parent + '_u%04d.json' % i for parent in PARENTS for i in range(6)]\nCLASSES = ('direct_flip', 'direct_stay', 'look_flip', 'look_stay')\n\n\ndef require(value, reason):\n    if not value:\n        raise ValueError(reason)\n\n\ndef source_bytes(reference):\n    path = (ROOT / reference['file']).resolve()\n    path.relative_to(ROOT / 'results')\n    body = path.read_bytes()\n    require(hashlib.sha256(body).hexdigest() == reference['sha256'], 'Original export bytes changed')\n    data = json.loads(body)\n    require(data['_meta']['metrics_sha256'] == reference['metrics_sha256'] == canonical_hash(data['metrics']),\n            'Original export metrics identity changed')\n    return data\n\n\ndef main():\n    cache_name, name = sys.argv[1:]\n    require(cache_name == 't02_export_cache_remaining24_01'\n            or cache_name.startswith('t02_export_cache_remaining24_01_retry'), 'Wrong fixed-cutoff cache')\n    require(name == os.environ.get('CVPR_RUN_NAME'), 'Use the explicitly named logged summary')\n    data, reference = audited_result('results/' + cache_name + '.json')\n    cfg, metrics, meta = data['config'], data['metrics'], data['_meta']\n    require(meta.get('end') and meta.get('exit_code') == 0 and cfg['source'] == SOURCES\n            and cfg.get('version') == cache.VERSION and cfg.get('policy') == cache.CACHE_POLICY\n            and cfg.get('sample_size') == 200 and cfg.get('seed') == 0 and cfg.get('gpus') == 1\n            and metrics.get('cache_matches_live') is True and metrics.get('sample_complete') is True\n            and metrics.get('downstream_allowed') is True and metrics.get('stop_downstream') is False\n            and metrics.get('errors') == [] and metrics.get('cleanup_errors') == []\n            and metrics.get('missing_state_keys') == [] and metrics.get('black_frame_detected') is False,\n            'Original entire-population cache did not complete successfully; no passed class counts')\n    directory = Path(cfg['scratch_directory']).resolve()\n    require(directory == Path(cfg['scratch']).resolve() / 't02_cache' / cache_name / cfg['pbs_jobid'],\n            'Wrong original cache scratch namespace')\n    report = cache.read_json_ref(metrics['validation_report'], directory, expected=directory / 'cache_validation.json')\n    plan = cache.read_json_ref(metrics['sampling_plan'], directory, expected=directory / 'sampling_plan.json')\n    certificate = cache.read_json_ref(metrics['authorization_manifest'], directory, expected=directory / 'cache_authorization.json')\n    require_cache_validation(report)\n    require(report.get('table_native_and_pair_checks_authorized') is True\n            and report.get('producer_cleanup_errors') == [] and report.get('producer_errors') == []\n            and report['sampling_plan'] == plan and cfg['population_sha256'] == plan['population_sha256']\n            and plan['seed'] == 0 and plan['sample_size'] == 200\n            and certificate.get('version') == cache.VERSION\n            and certificate.get('cache_validation') == metrics['validation_report']\n            and certificate.get('sampling_plan') == metrics['sampling_plan']\n            and certificate.get('full_T02_acceptance') is None,\n            'Original report and whole-population certificate do not bind the same sample')\n    selected = [tuple(key) for key in plan['selected_keys']]\n    observed = [(row['dataset_key'], row['state_id']) for row in report['states']]\n    require(len(set(selected)) == len(selected) == len(observed) == 200 and set(selected) == set(observed),\n            'Original fixed 200-state sample was incomplete or replaced')\n    fresh = {(row['dataset_key'], row['state_id'], world_name, world['fresh_source']['render_id'])\n             for row in report['states'] for world_name, world in row['worlds'].items()}\n    require(fresh == {tuple(key) for key in report['native_authenticated_render_ids']},\n            'Report native authentication IDs do not cover its exact fresh renders')\n    ledger = metrics['population_ledger']\n    require([row['source']['file'] for row in ledger] == SOURCES\n            and len({row['dataset_key'] for row in ledger}) == len(ledger)\n            and all(row['population_membership'] == 'complete_independently_verified_table' for row in ledger)\n            and certificate['tables'] == {row['dataset_key']: {field: row['table_manifest'][field]\n                for field in ('file', 'sha256', 'bytes')} for row in ledger}\n            and report['table_shadow_metadata'] == certificate['table_shadow_metadata'] == metrics['table_shadow_metadata'],\n            'Certificate population differs from the complete fixed 24-source inventory')\n    rows = []\n    for entry in ledger:\n        original = source_bytes(entry['source'])\n        require(entry['source'] in data['sources'] and original['_meta']['exit_code'] == 0\n                and original['metrics']['export_checks_complete'] is True\n                and original['metrics']['errors'] == original['metrics']['cleanup_errors'] == [],\n                'Population source differs from original authenticated successful export')\n        original_rows = original['metrics']['pairs']\n        require(len(original_rows) == 1, 'Expected one original pair per source')\n        row = original_rows[0]\n        require(row['pair_id'] == entry['original_pair_id'] == entry['pair_id']\n                and row['status'] == 'exported' and row['table_manifest'] == entry['table_manifest']\n                and row['kind'] in CLASSES, 'Original class/pair/table identity does not match certificate population')\n        rows.append({'dataset_key': entry['dataset_key'], 'pair_id': row['pair_id'], 'scene': row['scene'],\n                     'kind': row['kind'], 'source': entry['source'], 'table_manifest': entry['table_manifest'],\n                     'shadow_divergent_states': entry['shadow_divergent_states'], 'in_clean_subset': entry['in_clean_subset']})\n    original_classes = {row['dataset_key']: row['kind'] for row in rows}\n    require(all(row['kind'] == original_classes[row['dataset_key']] for row in report['states']),\n            'Sampled cache class differs from its exact original exported pair class')\n    output = {'cache_result': reference, 'authorization_manifest': metrics['authorization_manifest'],\n        'validation_report': metrics['validation_report'], 'sampling_plan': metrics['sampling_plan'],\n        'pair_count': len(rows), 'by_class': {kind: sum(row['kind'] == kind for row in rows) for kind in CLASSES},\n        'observed_distinct_states': report['observed_distinct_states'], 'population_size': plan['population_size'],\n        'measured_total_duration_seconds': meta['duration_sec'], 'job_id': cfg['pbs_jobid'], 'rows': rows,\n        'scope': 'Reading the original complete export/native/cache certificate; no new scientific acceptance, no repeat native scan, no measured speedup claim.',\n        'full_T02_acceptance': None, 'balance_checked_here': False, 'throughput_checked_here': False,\n        'training_pool_frozen': False}\n    destination = ROOT / 'logs/review' / name\n    destination.mkdir(exist_ok=False)\n    path = destination / 'certificate_summary.json'\n    with path.open('x') as stream:\n        json.dump(output, stream, indent=2, sort_keys=True, allow_nan=False)\n        stream.write('\\n')\n    print('T02_REMAINING24_CERTIFICATE_SUMMARY_JSON: ' + json.dumps({\n        'report': {'file': str(path.relative_to(ROOT)), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()},\n        **{k: output[k] for k in ('pair_count', 'by_class', 'observed_distinct_states', 'measured_total_duration_seconds', 'job_id')}\n    }, sort_keys=True), flush=True)\n\n\nif __name__ == '__main__':\n    main()\n",
