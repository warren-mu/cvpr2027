+      "\"\"\"One-off read-only guard for two exact native black-gate chains.\n\nRun inline only through run_logged + record_command. No qsub/qdel, result\nmutation, name normalization, live process inference, or synthetic payloads.\n\"\"\"\nimport io\nimport json\nfrom pathlib import Path\nimport shlex\nimport subprocess\nfrom PIL import Image\nfrom src.tools import phase_watch as watch\n\nROOT = Path.cwd().resolve()\nauditor = watch.load_module('oneoff_black_auditor', ROOT / 'scripts/audit_provenance.py')\n\n\ndef require(value, reason):\n    if not value:\n        raise ValueError(reason)\n\n\ndef logged(name):\n    return watch.load_logged(ROOT, ROOT / 'results' / (name + '.json'), auditor)\n\n\ndef reference(path):\n    path = Path(path).resolve()\n    return {'file': str(path.relative_to(ROOT)), 'sha256': watch.digest(path), 'bytes': path.stat().st_size}\n\n\ndef bind(ref, data, path):\n    require(ref['file'] == str(path.relative_to(ROOT)) and ref['sha256'] == watch.digest(path)\n            and ref['metrics_sha256'] == data['_meta']['metrics_sha256']\n            and ref['exit_code'] == data['_meta']['exit_code'], 'Original nested result reference differs')\n\n\ndef validate(job, name, receipt_dir, accounting_name, inner_name=None):\n    directory = (ROOT / 'logs/pbs' / receipt_dir).resolve()\n    pp, sp, rp = directory / 'payload.json', directory / 'job.pbs', directory / 'submission.json'\n    payload, receipt = json.loads(pp.read_text()), json.loads(rp.read_text())\n    outer, outer_ref = logged(name)\n    account, account_ref = logged(accounting_name)\n    require(account['_meta']['exit_code'] == 0 and account['metrics']['complete_allocation_accounting'] is True\n            and account['config']['errors'] == [], 'Accounting not complete')\n    ac = account['_meta']['command']\n    require(ac == ['python3', 'src/tools/pbs_usage.py', '--name', accounting_name, job],\n            'Require the exact canonical logged PBS accounting command')\n    account_log = (ROOT / account['_meta']['log_path']).read_text()\n    require(json.dumps(account['config'], indent=2) in account_log, 'PBS config absent from authenticated original log')\n    entries = [row for row in account['config']['jobs'] if row['job_id'] == job]\n    require(len(entries) == 1 and entries[0]['qstat_exit'] == 0, 'PBS job missing/ambiguous')\n    fields = entries[0]['fields']\n    require(fields['project'] == 'CFP04-SF-125' and fields['job_state'] == 'F'\n            and fields['Exit_status'] == '86' and fields['run_count'] == '1'\n            and fields['Job_Owner'].split('@')[0] == 'e1583364', 'Not this owned terminal black-only job')\n    require(payload['repo'] == str(ROOT) and payload['name'] == name and payload['task_id'] == 'T01'\n            and payload['queue'] == 'autox' and payload['requested_host'] is None\n            and payload['requested_gpu_count'] == 1 and payload['dry_run'] is False,\n            'Original immutable allocation differs')\n    require(pp.stat().st_mode & 0o222 == 0 and sp.stat().st_mode & 0o222 == 0, 'Original payload/script is not immutable')\n    require(receipt['returncode'] == 0 and receipt['stdout'].strip() == job and not receipt['stderr'],\n            'Receipt does not prove one successful submission of the exact job')\n    wall = fields['Resource_List.walltime']\n    h, m, s = map(int, wall.split(':'))\n    require(h * 3600 + m * 60 + s == payload['requested_wall_seconds']\n            and fields['Resource_List.ngpus'] == '1' and fields['Resource_List.ncpus'] == '12'\n            and fields['queue'] == 'smallx' and 'PBS_O_QUEUE=autox' in fields['Variable_List']\n            and float(fields['Resource_List.queue_charge_rate']) == payload['requested_queue_charge_rate'],\n            'PBS resources/router/charge differ from original payload')\n    expected_qsub = ['qsub', '-N', fields['Job_Name'], '-l', 'walltime=' + wall,\n                     '-o', str(directory / 'pbs.out'), str(sp)]\n    require(receipt['command'] ==