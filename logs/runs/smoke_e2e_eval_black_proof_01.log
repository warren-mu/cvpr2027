# run_logged: python3 -m src.tools.record_command --name smoke_e2e_eval_black_proof_01 -- python3 -c import json,copy
from pathlib import Path
from src.tools import phase_watch as w
root=Path.cwd().resolve()
aud=w.load_module('black_auditor',root/'scripts/audit_provenance.py')
paths=list(root.glob('logs/pbs/smoke_e2e_eval_01-*/payload.json'))
assert len(paths)==1
payload=json.load(paths[0].open())
outer,oe=w.load_logged(root,root/'results/smoke_e2e_eval_01.json',aud)
gate,ge=w.load_logged(root,root/'results/smoke_e2e_eval_01_gate.json',aud)
account=json.load(open('results/smoke_e2e_eval_black_accounting_01.json'))
assert account['metrics']['complete_allocation_accounting'] is True
assert len(account['config']['jobs'])==1
fields=account['config']['jobs'][0]['fields']; job='707539.hopper-m-02'
cfg,metrics=outer['config'],outer['metrics']
assert payload['task_id']=='T01' and payload['budget_group']=='E2E' and payload['requested_gpu_count']==1 and payload['requested_host'] is None
assert payload['command']==['python3','-u','-m','src.tools.smoke_e2e_eval','--name','smoke_e2e_eval_01','--replay','results/smoke_e2e_replay_01.json','--timeout-seconds','1140']
assert cfg['identity']['pbs_jobid']==job and cfg['gpus']==1 and cfg['version']=='smoke_e2e_original_model_eval_v1'
assert metrics['kind']=='smoke_e2e_eval' and metrics['producer_exit_code']==86 and metrics['step3_passed'] is False
assert metrics['errors']==[] and metrics['cleanup_errors']==[] and metrics['black_frame_detected'] is True
assert gate['config']['resolution']==255 and gate['config']['segmentation'] is True
normalized=copy.deepcopy(outer)
normalized['config']['pbs_jobid']=cfg['identity']['pbs_jobid']
reason=w.validate_black_retry(payload,job,fields,normalized,gate,'smoke_e2e_eval_01_gate','e2e_eval')
print(json.dumps({'reason':reason,'job_id':job,'node':cfg['node'],'gpu_uuid':gate['config']['allocation']['devices'][0]['gpu_uuid'],'outer':oe,'gate':ge,'schema_normalization':'Read-only copy exposes the verified identity.pbs_jobid to the existing gate validator; original source bytes and metadata remain unchanged.'},sort_keys=True))

