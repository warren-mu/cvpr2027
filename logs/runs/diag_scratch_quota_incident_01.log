def run(command):
 try:
  p=subprocess.run(command,text=True,capture_output=True,timeout=50)
  return {'command':command,'exit_code':p.returncode,'stdout':p.stdout,'stderr':p.stderr}
 except subprocess.TimeoutExpired as e:
