<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Algorithm</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> GLANCE</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l0" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
            
            
           Learning rate for RL <math id="alg1.l0.m1" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> and visual-linguistic alignment <math id="alg1.l0.m2" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math>, EMA decay <math id="alg1.l0.m3" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>, intrinsic reward scale <math id="alg1.l0.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>, curiosity drain parameters <math id="alg1.l0.m5" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> and <math id="alg1.l0.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>.

</div>
<div id="alg1.l0a" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0a.1" class="ltx_text" style="font-size:80%;">0:</span></span>
            
            
           VLM parameters <math id="alg1.l0a.m1" class="ltx_Math" alttext="\boldsymbol{\theta}=\{\mathbf{v},\boldsymbol{\ell}\}" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>𝐯</mi><mo>,</mo><mi class="ltx_mathvariant_bold" mathvariant="bold">ℓ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\theta}=\{\mathbf{v},\boldsymbol{\ell}\}</annotation></semantics></math>, projector parameters <math id="alg1.l0a.m2" class="ltx_Math" alttext="\boldsymbol{\psi}" display="inline" intent=":literal"><semantics><mi>𝝍</mi><annotation encoding="application/x-tex">\boldsymbol{\psi}</annotation></semantics></math>, momentum encoder <math id="alg1.l0a.m3" class="ltx_Math" alttext="\boldsymbol{\phi}\leftarrow\mathbf{v}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo stretchy="false">←</mo><mi>𝐯</mi></mrow><annotation encoding="application/x-tex">\boldsymbol{\phi}\leftarrow\mathbf{v}</annotation></semantics></math>, and replay buffer <math id="alg1.l0a.m4" class="ltx_Math" alttext="\mathcal{B}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{B}\leftarrow\emptyset</annotation></semantics></math>.

</div>
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
           <span id="alg1.l1.3" class="ltx_text ltx_font_bold">for</span> iteration <math id="alg1.l1.m1" class="ltx_Math" alttext="i=1,2,\dots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">i=1,2,\dots</annotation></semantics></math> <span id="alg1.l1.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
            <span id="alg1.l2.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#6E6E6E;">#1: Trajectory Rollout</span>

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
            <span id="alg1.l3.3" class="ltx_text ltx_font_bold">for</span> step <math id="alg1.l3.m1" class="ltx_Math" alttext="t=1,\dots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,\dots,T</annotation></semantics></math> <span id="alg1.l3.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
             Observe <math id="alg1.l4.m1" class="ltx_Math" alttext="o_{t}" display="inline" intent=":literal"><semantics><msub><mi>o</mi><mi>t</mi></msub><annotation encoding="application/x-tex">o_{t}</annotation></semantics></math> and generate response <math id="alg1.l4.m2" class="ltx_math_unparsed" alttext="a_{t}\sim\pi_{\boldsymbol{\theta}}(\cdot|o_{t},h_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>∼</mo><msub><mi>π</mi><mi>𝜽</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>o</mi><mi>t</mi></msub><mo>,</mo><msub><mi>h</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">a_{t}\sim\pi_{\boldsymbol{\theta}}(\cdot|o_{t},h_{t})</annotation></semantics></math> with explicit prediction <math id="alg1.l4.m3" class="ltx_Math" alttext="s_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">s_{t+1}</annotation></semantics></math>.

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
             Execute action <math id="alg1.l5.m1" class="ltx_Math" alttext="a_{t}" display="inline" intent=":literal"><semantics><msub><mi>a</mi><mi>t</mi></msub><annotation encoding="application/x-tex">a_{t}</annotation></semantics></math> in environment, receive <math id="alg1.l5.m2" class="ltx_Math" alttext="o_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">o_{t+1}</annotation></semantics></math> and task reward <math id="alg1.l5.m3" class="ltx_Math" alttext="r_{t}^{\text{task}}" display="inline" intent=":literal"><semantics><msubsup><mi>r</mi><mi>t</mi><mtext>task</mtext></msubsup><annotation encoding="application/x-tex">r_{t}^{\text{task}}</annotation></semantics></math>.

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
             Extract online latent <math id="alg1.l6.m1" class="ltx_Math" alttext="h_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>h</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">h_{t+1}</annotation></semantics></math> at <span id="alg1.l6.3" class="ltx_text ltx_markedasmath ltx_font_typewriter">&lt;/prediction&gt;</span> and target latent <math id="alg1.l6.m3" class="ltx_Math" alttext="y_{t+1}=\texttt{sg}(f_{\boldsymbol{\psi}}(o_{t+1}))" display="inline" intent=":literal"><semantics><mrow><msub><mi>y</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mtext class="ltx_mathvariant_monospace">sg</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>𝝍</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>o</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y_{t+1}=\texttt{sg}(f_{\boldsymbol{\psi}}(o_{t+1}))</annotation></semantics></math>.

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
             Compute prediction error <math id="alg1.l7.m1" class="ltx_Math" alttext="\mathcal{L}_{\texttt{explore}}(h_{t+1},y_{t+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext class="ltx_mathvariant_monospace">explore</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>y</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\texttt{explore}}(h_{t+1},y_{t+1})</annotation></semantics></math> and intrinsic reward <math id="alg1.l7.m2" class="ltx_Math" alttext="r_{t}^{\text{i}}=\beta\cdot\texttt{Normalize}(\mathcal{L}_{\texttt{explore}})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mi>t</mi><mtext>i</mtext></msubsup><mo>=</mo><mrow><mrow><mi>β</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mtext class="ltx_mathvariant_monospace">Normalize</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext class="ltx_mathvariant_monospace">explore</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{t}^{\text{i}}=\beta\cdot\texttt{Normalize}(\mathcal{L}_{\texttt{explore}})</annotation></semantics></math>.

</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
             Store transition and latent pair in <math id="alg1.l8.m1" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math>.

</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
            <span id="alg1.l9.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l9.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
            <span id="alg1.l10.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#6E6E6E;">#2: Optimization</span>

</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
            <span id="alg1.l11.3" class="ltx_text ltx_font_bold">Step A: Joint Representation Learning</span>

</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
             Freeze <math id="alg1.l12.m1" class="ltx_Math" alttext="\boldsymbol{\ell}" display="inline" intent=":literal"><semantics><mi class="ltx_mathvariant_bold" mathvariant="bold">ℓ</mi><annotation encoding="application/x-tex">\boldsymbol{\ell}</annotation></semantics></math> to preserve linguistic reasoning.

</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
             Sample latent pairs from <math id="alg1.l13.m1" class="ltx_Math" alttext="\mathcal{B}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℬ</mi><annotation encoding="application/x-tex">\mathcal{B}</annotation></semantics></math>, compute <math id="alg1.l13.m2" class="ltx_Math" alttext="\nabla\mathcal{L}_{\texttt{explore}}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext class="ltx_mathvariant_monospace">explore</mtext></msub></mrow><annotation encoding="application/x-tex">\nabla\mathcal{L}_{\texttt{explore}}</annotation></semantics></math> w.r.t. <math id="alg1.l13.m3" class="ltx_Math" alttext="\{\boldsymbol{\psi},\mathbf{v}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>𝝍</mi><mo>,</mo><mi>𝐯</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{\psi},\mathbf{v}\}</annotation></semantics></math>.

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
             Update projector and visual encoder:

</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
              <math id="alg1.l15.m1" class="ltx_Math" alttext="\boldsymbol{\psi}\leftarrow\boldsymbol{\psi}-\kappa\nabla_{\boldsymbol{\psi}}\mathcal{L}_{\texttt{explore}}" display="inline" intent=":literal"><semantics><mrow><mi>𝝍</mi><mo stretchy="false">←</mo><mrow><mi>𝝍</mi><mo>−</mo><mrow><mi>κ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝝍</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext class="ltx_mathvariant_monospace">explore</mtext></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\psi}\leftarrow\boldsymbol{\psi}-\kappa\nabla_{\boldsymbol{\psi}}\mathcal{L}_{\texttt{explore}}</annotation></semantics></math>

</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
              <math id="alg1.l16.m1" class="ltx_Math" alttext="\mathbf{v}\leftarrow\mathbf{v}-\kappa\nabla_{\mathbf{v}}\mathcal{L}_{\texttt{explore}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐯</mi><mo stretchy="false">←</mo><mrow><mi>𝐯</mi><mo>−</mo><mrow><mi>κ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝐯</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext class="ltx_mathvariant_monospace">explore</mtext></msub></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{v}\leftarrow\mathbf{v}-\kappa\nabla_{\mathbf{v}}\mathcal{L}_{\texttt{explore}}</annotation></semantics></math>

</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
            <span id="alg1.l17.3" class="ltx_text ltx_font_bold">Step B: Policy and Critic Update</span>

</div>
<div id="alg1.l18" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
            
            
             Compute Advantages <math id="alg1.l18.m1" class="ltx_Math" alttext="A_{t}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>t</mi></msub><annotation encoding="application/x-tex">A_{t}</annotation></semantics></math> using Bi-level GAE on <math id="alg1.l18.m2" class="ltx_Math" alttext="r_{t}^{\text{total}}=r_{t}^{\text{task}}+r_{t}^{\text{i}}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mi>t</mi><mtext>total</mtext></msubsup><mo>=</mo><mrow><msubsup><mi>r</mi><mi>t</mi><mtext>task</mtext></msubsup><mo>+</mo><msubsup><mi>r</mi><mi>t</mi><mtext>i</mtext></msubsup></mrow></mrow><annotation encoding="application/x-tex">r_{t}^{\text{total}}=r_{t}^{\text{task}}+r_{t}^{\text{i}}</annotation></semantics></math>.

</div>
<div id="alg1.l19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
            
            
             Unfreeze <math id="alg1.l19.m1" class="ltx_Math" alttext="\boldsymbol{\ell}" display="inline" intent=":literal"><semantics><mi class="ltx_mathvariant_bold" mathvariant="bold">ℓ</mi><annotation encoding="application/x-tex">\boldsymbol{\ell}</annotation></semantics></math> and update full parameters <math id="alg1.l19.m2" class="ltx_Math" alttext="\boldsymbol{\theta}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">\boldsymbol{\theta}</annotation></semantics></math> via PPO objective:

</div>
<div id="alg1.l20" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
            
            
              <math id="alg1.l20.m1" class="ltx_Math" alttext="\boldsymbol{\theta}\leftarrow\boldsymbol{\theta}-\eta\nabla_{\boldsymbol{\theta}}\mathcal{J}_{\text{PPO}}(\boldsymbol{\theta})" display="inline" intent=":literal"><semantics><mrow><mi>𝜽</mi><mo stretchy="false">←</mo><mrow><mi>𝜽</mi><mo>−</mo><mrow><mi>η</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝜽</mi></msub><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mtext>PPO</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝜽</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\theta}\leftarrow\boldsymbol{\theta}-\eta\nabla_{\boldsymbol{\theta}}\mathcal{J}_{\text{PPO}}(\boldsymbol{\theta})</annotation></semantics></math>

</div>
<div id="alg1.l21" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
            
            
            <span id="alg1.l21.3" class="ltx_text ltx_font_bold">Step C: Momentum Encoder Update</span>

</div>
<div id="alg1.l22" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
            
            
             <math id="alg1.l22.m1" class="ltx_Math" alttext="\boldsymbol{\phi}\leftarrow\alpha\boldsymbol{\phi}+(1-\alpha)\mathbf{v}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi><mo stretchy="false">←</mo><mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_mathvariant_bold-italic" mathvariant="bold-italic">ϕ</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐯</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\phi}\leftarrow\alpha\boldsymbol{\phi}+(1-\alpha)\mathbf{v}</annotation></semantics></math>

</div>
<div id="alg1.l23" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
            
            
            <span id="alg1.l23.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#6E6E6E;">#3: Rejuvenation (Optional)</span>

</div>
<div id="alg1.l24" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
            
            
            <span id="alg1.l24.3" class="ltx_text ltx_font_bold">if</span> <span id="alg1.l24.4" class="ltx_text ltx_font_typewriter">curiosity drain</span> <span id="alg1.l24.5" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg1.l25" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l25.1" class="ltx_text" style="font-size:80%;">25:</span></span>
            
            
             <math id="alg1.l25.m1" class="ltx_Math" alttext="\boldsymbol{\psi}\leftarrow\texttt{Randomly Initialize}(\boldsymbol{\psi})" display="inline" intent=":literal"><semantics><mrow><mi>𝝍</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_monospace">Randomly Initialize</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝝍</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\psi}\leftarrow\texttt{Randomly Initialize}(\boldsymbol{\psi})</annotation></semantics></math>

</div>
<div id="alg1.l26" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l26.1" class="ltx_text" style="font-size:80%;">26:</span></span>
            
            
            <span id="alg1.l26.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l26.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l27" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l27.1" class="ltx_text" style="font-size:80%;">27:</span></span>
            
            
            Clear the buffer <math id="alg1.l27.m1" class="ltx_Math" alttext="\mathcal{B}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℬ</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{B}\leftarrow\emptyset</annotation></semantics></math>.

</div>
<div id="alg1.l28" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l28.1" class="ltx_text" style="font-size:80%;">28:</span></span>
            
            
           <span id="alg1.l28.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l28.4" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Experimental Details.</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Baseline</h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p">To evaluate the robustness and plug-and-play nature of <span id="A2.SS1.p1.1.1" class="ltx_text ltx_font_smallcaps">GLANCE</span>, we benchmark against several RL baselines specifically designed for VLM agents or multi-turn reasoning. All trained baselines share the same <span id="A2.SS1.p1.1.2" class="ltx_text ltx_font_typewriter">Qwen2.5-VL-3B</span> backbone and the internalized world-modeling action structure <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="a_{t}=\langle z_{t},a_{t}^{e}\rangle" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>=</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>a</mi><mi>t</mi><mi>e</mi></msubsup></mrow><mo stretchy="false">⟩</mo></mrow></mrow><annotation encoding="application/x-tex">a_{t}=\langle z_{t},a_{t}^{e}\rangle</annotation></semantics></math> defined in Section <a href="#S2.SS2" title="2.2 Internal World Models in VLM Agents ‣ 2 Preliminaries ‣ What You Think is What You See: Driving Exploration in VLM Agents via Visual-Linguistic Curiosity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>. The primary distinctions between these baselines lie in the composition of the extrinsic reward <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="r_{t}^{e}" display="inline" intent=":literal"><semantics><msubsup><mi>r</mi><mi>t</mi><mi>e</mi></msubsup><annotation encoding="application/x-tex">r_{t}^{e}</annotation></semantics></math> and the granularity of the credit assignment mechanism (i.e., advantage estimation). Table <a href="#A2.T3" title="Table 3 ‣ B.1 Baseline ‣ Appendix B Experimental Details. ‣ What You Think is What You See: Driving Exploration in VLM Agents via Visual-Linguistic Curiosity" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> summarizes these differences.</p>
</div>
<figure id="A2.T3" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A2.T3.4" class="ltx_text" style="font-size:90%;">Table 3</span>: </span><span id="A2.T3.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Key differences between RL baselines.<span id="A2.T3.5.1" class="ltx_text ltx_font_medium"> We categorize baselines by their extrinsic reward density and the level at which advantages are calculated and propagated.</span></span></figcaption>
<table id="A2.T3.6" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A2.T3.6.1" class="ltx_tr">
<th id="A2.T3.6.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.6.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Baseline</span></th>
<th id="A2.T3.6.1.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.9pt;padding-bottom:0.9pt;">
<span id="A2.T3.6.1.2.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="A2.T3.6.1.2.1.1" class="ltx_p"><span id="A2.T3.6.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Extrinsic Reward (<math id="A2.T3.m1" class="ltx_Math" alttext="r_{t}^{e}" display="inline" intent=":literal"><semantics><msubsup><mi>r</mi><mi>t</mi><mi>e</mi></msubsup><annotation encoding="application/x-tex">r_{t}^{e}</annotation></semantics></math>)</span></span>
</span></th>
<th id="A2.T3.6.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.6.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Advantage Estimation</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A2.T3.6.2" class="ltx_tr">
<td id="A2.T3.6.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.6.2.1.1" class="ltx_text" style="font-size:90%;">VAGEN-Full <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Wang et al., 2025</a>)</cite></span></td>
<td id="A2.T3.6.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;">
<span id="A2.T3.6.2.2.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="A2.T3.6.2.2.1.1" class="ltx_p"><span id="A2.T3.6.2.2.1.1.1" class="ltx_text" style="font-size:90%;">Dense: </span><math id="A2.T3.m2" class="ltx_Math" alttext="r^{\text{task}}_{t}+r^{\text{reason}}_{t}+r^{\text{format}}_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">r</mi><mi mathsize="0.900em">t</mi><mtext mathsize="0.900em">task</mtext></msubsup><mo mathsize="0.900em">+</mo><msubsup><mi mathsize="0.900em">r</mi><mi mathsize="0.900em">t</mi><mtext mathsize="0.900em">reason</mtext></msubsup><mo mathsize="0.900em">+</mo><msubsup><mi mathsize="0.900em">r</mi><mi mathsize="0.900em">t</mi><mtext mathsize="0.900em">format</mtext></msubsup></mrow><annotation encoding="application/x-tex">r^{\text{task}}_{t}+r^{\text{reason}}_{t}+r^{\text{format}}_{t}</annotation></semantics></math></span>
</span></td>
<td id="A2.T3.6.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.6.2.3.1" class="ltx_text" style="font-size:90%;">Bi-Level GAE</span></td></tr>
<tr id="A2.T3.6.3" class="ltx_tr">
<td id="A2.T3.6.3.1" class="ltx_td ltx_align_left" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.6.3.1.1" class="ltx_text" style="font-size:90%;">VAGEN-Base <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib6" title="" class="ltx_ref">Wang et al., 2025</a>)</cite></span></td>
<td id="A2.T3.6.3.2" class="ltx_td ltx_align_left ltx_align_top" style="padding-top:0.9pt;padding-bottom:0.9pt;">
