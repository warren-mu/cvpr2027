<span id="A2.T3.6.3.2.1.1" class="ltx_p"><span id="A2.T3.6.3.2.1.1.1" class="ltx_text" style="font-size:90%;">Sparse: </span><math id="A2.T3.m3" class="ltx_Math" alttext="r^{\text{task}}_{t}+r^{\text{format}}_{t}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">r</mi><mi mathsize="0.900em">t</mi><mtext mathsize="0.900em">task</mtext></msubsup><mo mathsize="0.900em">+</mo><msubsup><mi mathsize="0.900em">r</mi><mi mathsize="0.900em">t</mi><mtext mathsize="0.900em">format</mtext></msubsup></mrow><annotation encoding="application/x-tex">r^{\text{task}}_{t}+r^{\text{format}}_{t}</annotation></semantics></math></span>
</span></td>
<td id="A2.T3.6.3.3" class="ltx_td ltx_align_left" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.6.3.3.1" class="ltx_text" style="font-size:90%;">Token-Level GAE</span></td></tr>
<tr id="A2.T3.6.4" class="ltx_tr">
