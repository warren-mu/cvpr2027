<span id="S4.T2.5.1.1.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T2.5.1.1.1.1.4.1" class="ltx_text ltx_font_bold">Navigation (Avg)</span></span></span>
</span>
