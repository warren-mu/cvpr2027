+++    "\"\"\"Authorized one-off recovery of original payload permissions, never bytes.\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport shutil\nimport stat\nimport subprocess\nfrom src.tools.pbs_mixed_accounting import logged, reference, read_reference\n\nroot = Path.cwd().resolve()\nassert os.environ.get('CVPR_RUN_NAME') == 'diag_gpu_pack_payload_mode_restore_01'\nitems = [\n    ('709349.hopper-m-02', 'gpu_pack_training_single_01', 'gpu_pack_training_single_01-20261109T225356Z-d587de07'),\n    ('709350.hopper-m-02', 'gpu_pack_training_single_02', 'gpu_pack_training_single_02-20261109T225606Z-ded8d8d9'),\n]\nverified = []\nfor job, name, receipt_dir in items:\n    payload_path = root / 'logs/pbs' / receipt_dir / 'payload.json'\n    payload_ref = reference(payload_path, root)\n    payload, _ = read_reference(root, payload_ref)\n    pack, _ = logged(root, reference(root / 'results' / (name + '.json'), root))\n    parent_ref = pack['config']['parent_payload_reference']\n    _, linked = read_reference(root, parent_ref, root / 'logs/pbs')\n    assert linked == payload_path.resolve() and parent_ref['sha256'] == payload_ref['sha256']\n    assert payload['name'] == name and payload['dry_run'] is False\n    assert pack['config']['pbs_jobid'] == job\n    assert pack['metrics']['all_owned_units_ended'] is True and pack['metrics']['cleanup_errors'] == []\n    receipt_path = payload_path.with_name('submission.json')\n    receipt = json.loads(receipt_path.read_bytes())\n    assert receipt['returncode'] == 0 and receipt['stdout'].strip() == job\n    original = subprocess.run(['git', 'show', '82031465:' + str(payload_path.relative_to(root))],\n                              check=True, stdout=subprocess.PIPE).stdout\n    assert original == payload_path.read_bytes()\n    assert stat.S_IMODE(payload_path.stat().st_mode) == 0o644\n    claim_refs = []\n    for entry in pack['metrics']['unit_claims']:\n        claim, _ = read_reference(root, entry['claim_reference'], Path(pack['config']['queue_root']))\n        assert claim['pbs_jobid'] == job and claim['unit_id'] == entry['unit_id']\n        _, claim_payload = read_reference(root, claim['parent_payload_reference'], root / 'logs/pbs')\n        assert claim_payload == payload_path.resolve()\n        assert claim['parent_payload_reference']['sha256'] == payload_ref['sha256']\n        claim_refs.append(entry['claim_reference'])\n    assert claim_refs\n    failed_name = name + '_mixed_accounting'\n    meta_path = root / 'logs/runs' / (failed_name + '.meta.json')\n    failed_meta = json.loads(meta_path.read_bytes())\n    assert failed_meta['exit_code'] == 1 and failed_meta.get('end')\n    assert failed_meta.get('results_missing') is True\n    assert not (root / 'results' / (failed_name + '.json')).exists()\n    log_path = root / 'logs/runs' / (failed_name + '.log')\n    assert 'Mixed accounting requires an original immutable submitted payload' in log_path.read_text()\n    artifacts = [log_path, meta_path]\n    diff_path = root / 'logs/runs' / (failed_name + '.diff')\n    if diff_path.exists(): artifacts.append(diff_path)\n    if failed_meta.get('git_diff_path'):\n        recorded_diff = (root / failed_meta['git_diff_path']).resolve()\n        assert recorded_diff in [p.resolve() for p in artifacts]\n    archive = root / 'results/_archive' / (failed_name + '.before_permission_restore_01')\n    assert not archive.exists()\n    verified.append(dict(job=job, name=name, path=payload_path, ref=payload_ref,\n                         receipt=reference(receipt_path, root), claims=claim_refs,\n                         artifacts=artifacts, archive=archive,\n                         original_commit='82031465', original_git_sha256=hashlib.sha256(original).hexdigest()))\n\n# No mutation until both original payloads, claimed copies and ended failures agree.\nrecords = []\nfor item in verified:\n    archived = []\n    item['archive'].mkdir(parents=True, exist_ok=False)\n    for source in item['artifacts']:\n        before = reference(source, root)\n        target = item['archive'] / source.name\n        shutil.move(str(source), str(target))\n        after = reference(target, root)\n        assert before['sha256'] == after['sha256'] and before['bytes'] == after['bytes']\n        archived.append({'original': before, 'archived': after})\n    before_mode = stat.S_IMODE(item['path'].stat().st_mode)\n    item['path'].chmod(0o444)\n    after_ref = reference(item['path'], root)\n    assert after_ref == item['ref']\n    after_mode = stat.S_IMODE(item['path'].stat().st_mode)\n    assert after_mode == 0o444\n    records.append({'job': item['job'], 'pack_name': item['name'],\n                    'payload_reference': after_ref, 'original_git_commit': item['original_commit'],\n                    'original_git_sha256': item['original_git_sha256'],\n                    'parent_and_claim_sha_verified': True, 'claim_references': item['claims'],\n                    'submission_reference': item['receipt'], 'before_mode': oct(before_mode),\n                    'after_mode': oct(after_mode), 'payload_bytes_unchanged': True,\n                    'archived_failed_artifacts': archived,\n                    'original_failed_result_absent': True})\nprint('PAYLOAD_PERMISSION_RECOVERY_JSON: ' + json.dumps(records, sort_keys=True, allow_nan=False), flush=True)\n"
