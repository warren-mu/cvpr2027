    except json.JSONDecodeError as e:row['unsealed_read_error']=str(e)
  record['original_metadata'].append(row)
out=Path('logs/review')/NAME;out.mkdir(parents=True,exist_ok=False);report=out/'snapshot.json'
with report.open('x') as f:json.dump(record,f,indent=2,sort_keys=True)
print('ORIGINAL_JOB_SNAPSHOT_JSON: '+json.dumps({'report':{'file':str(report),'sha256':hashlib.sha256(report.read_bytes()).hexdigest()},'query':record['query'].get('selected_original_fields',{'status':'unknown'}),'original_metadata':record['original_metadata']},sort_keys=True),flush=True)
signal.alarm(0)

