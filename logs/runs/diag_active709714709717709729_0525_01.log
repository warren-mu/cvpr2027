for name in names:
 for path in (Path('results')/(name+'.json'),Path('logs/runs')/(name+'.meta.json')):
  row={'file':str(path),'exists':path.is_file()}
  if row['exists']:
   row['bytes']=path.stat().st_size
   if row['bytes']>16*1024*1024: row['read']='omitted_size_bound'
   else:
