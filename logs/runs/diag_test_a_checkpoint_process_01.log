from pathlib import Path
for sample in range(2):
 for p in Path('/proc').iterdir():
  if not p.name.isdigit():continue
  try:
   if p.stat().st_uid!=os.getuid():continue
   args=p.joinpath('cmdline').read_bytes().split(bytes([0]));decoded=[x.decode(errors='replace') for x in args if x]
   if 'src.tools.t01v2_g01_review_checkpoint' not in decoded or 't01v2_checkpoint_test_a_full_01' not in decoded:continue
   print('PROCESS_SAMPLE',sample,subprocess.check_output(['ps','-p',p.name,'-o','pid,ppid,etime,time,pcpu,rss,stat,wchan:40'],text=True).strip(),flush=True)
   print('IO_SAMPLE',sample,p.name,p.joinpath('io').read_text().strip(),flush=True)
  except (OSError,subprocess.CalledProcessError) as e:print('PROCESS_READ_ERROR',repr(e),flush=True)
 if sample==0:time.sleep(2)

