from pathlib import Path
from concurrent.futures import ThreadPoolExecutor
base=Path('/scratch/e1583364')
out=Path('logs/review/diag_scratch_top10_01');out.mkdir(parents=True,exist_ok=False)
def run(kind):
 cmd=['du','--max-depth=2','--inodes' if kind=='inodes' else '--block-size=1',str(base)]
 try:
  r=subprocess.run(cmd,text=True,capture_output=True,timeout=600)
  raw=r.stdout;row={'command':cmd,'exit_code':r.returncode,'stderr':r.stderr}
 except subprocess.TimeoutExpired as e:
  raw=e.stdout.decode() if isinstance(e.stdout,bytes) else e.stdout or '';row={'command':cmd,'timeout_seconds':600}
 (out/(kind+'.txt')).write_text(raw)
 values={}
 for line in raw.splitlines():
  count,path=line.split('\t',1);values[path]=int(count)
 row['values']=values;return kind,row
rows=dict(ThreadPoolExecutor(max_workers=2).map(run,['bytes','inodes']))
capacity=rows['bytes']['values'];inodes=rows['inodes']['values']
eligible=[(path,size) for path,size in capacity.items() if (Path(path).parent==base and Path(path).name!='cvpr2027') or Path(path).parent==base/'cvpr2027']
largest=[{'path':path,'allocated_bytes':size,'file_objects_including_directories':inodes.get(path)} for path,size in sorted(eligible,key=lambda x:(-x[1],x[0]))[:10]]
result={'observed_at_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'scope':'Owner scratch root; top-level cvpr2027 expanded one level, other project roots retained as totals, so reported directory rows do not overlap. Read-only; no removals.','user_root_allocated_bytes':capacity.get(str(base)),'user_root_file_objects_including_directories':inodes.get(str(base)),'account_capacity_limit_bytes':None,'account_file_quota_limit':None,'limit_note':'Account limits require a separate quota response; global df/statvfs is not the account limit.','largest_directories':largest,'queries':rows}
(out/'report.json').write_text(json.dumps(result,indent=2)+'\n')
print(json.dumps({k:v for k,v in result.items() if k!='queries'},sort_keys=True),flush=True)
status=Path('STATUS.md');lines=['\n### scratch清理后目录占用（只读；'+result['observed_at_utc']+'）\n',result['scope'],'\n|目录|实际分配字节|文件对象数（包含目录）|','|---|---:|---:|']
for row in largest:lines.append('|{path}|{allocated_bytes}|{file_objects_including_directories}|'.format(**row))
lines.append('\n本账号scratch树实际分配字节：'+str(result['user_root_allocated_bytes'])+'；文件对象数：'+str(result['user_root_file_objects_including_directories'])+'。个人容量/文件数配额上限须以单独quota结果为准，不把集群df数字当个人配额。完整原查询及是否超时见logs/review/diag_scratch_top10_01/report.json。')
status.open('a').write('\n'.join(lines)+'\n')

