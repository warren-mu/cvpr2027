# run_logged: python3 -m src.tools.record_command --name diag_g01_checkpoint_preflight_01 -- python3 -c import hashlib,json
from pathlib import Path
root=Path.cwd()
def state(ref):
    if not isinstance(ref,dict): return {"reference":ref,"exists":False}
    p=Path(ref["file"])
    if not p.is_absolute(): p=root/p
    value={"file":str(p),"expected_sha256":ref.get("sha256"),"exists":p.exists(),"is_file":p.is_file(),"is_symlink":p.is_symlink()}
    if p.is_file():
        raw=p.read_bytes(); value.update(actual_sha256=hashlib.sha256(raw).hexdigest(),bytes=len(raw),mtime_ns=p.stat().st_mtime_ns)
        value["hash_matches"]=value["actual_sha256"]==ref.get("sha256")
    return value
out=[]
for name in ("gen_train_concurrency_s15_02_c2_floorplan1","gen_train_concurrency_s15_02_c2_floorplan7"):
    data=json.loads((root/"results"/(name+".json")).read_text()); m=data["metrics"]
    item={"source":name,"source_end":data["_meta"].get("end"),"selected_controller_id":m.get("selected_controller_id"),"scene_preflight":state(m.get("scene_preflight_reference")),"controllers":[],"passed_pairs":[]}
    for visit in m.get("controller_visits",[]):
        entry={k:visit.get(k) for k in ("controller_id","preflight_passed","cleanup_errors","error","worker_pid","role")}
        entry["preflight"]=state(visit.get("preflight_reference")); entry["raw_index"]=state(visit.get("raw_index"))
        ref=visit.get("raw_index")
        if ref and Path(ref["file"]).is_file():
            index=json.loads(Path(ref["file"]).read_text())
            entry["index_preflight_entries"]=[r for r in index.get("files",[]) if Path(r["file"]).name=="scene_preflight.json"]
        p=Path(entry["preflight"].get("file","/nonexistent"))
        if p.is_file():
            pre=json.loads(p.read_text())
            entry["preflight_status"]={k:pre.get(k) for k in ("passed","error","reasons","scene")}
        item["controllers"].append(entry)
    for ref in m.get("passed_pair_files",[]):
        p=root/ref["file"]; pair=json.loads(p.read_text())
        item["passed_pairs"].append({"pair_id":pair["pair_id"],"kind":pair["kind"],"controller":pair.get("search_controller_id"),"portable_preflight":state(pair.get("scene_preflight_reference"))})
    out.append(item)
print(json.dumps(out,indent=2,sort_keys=True))

