# run_logged: python3 -c """One-off exact second engineering smoke plan; root runs via run_logged."""
import copy
import hashlib
import json
import os
from pathlib import Path
from src.tools import g01_physics_smoke as smoke
from src.tools.t01_partition import audited_result

root = Path.cwd().resolve()
name = 'diag_g01_raw10_smoke_plan_02'
run = 'gen_test_s16_smoke_raw10_02'
assert os.environ.get('CVPR_RUN_NAME') == name
old_path = root / 'configs/gen_test_s16_smoke_raw10_01_quota.json'
old_bytes = old_path.read_bytes()
old_sha = hashlib.sha256(old_bytes).hexdigest()
assert old_sha == '4e9d8186eb770b248cb53ca0ae3f57e214f493d042d3b7e454d46b09766351f4'
original_path = root / 'results/gen_test_s16_smoke_raw10_01.json'
assert hashlib.sha256(original_path.read_bytes()).hexdigest() == '6a9748f3b54eacfeaa7519f7806ea427e840a6bc81c6f32ab4aeaab00872a635'
original, original_ref = audited_result(original_path)
assert original['_meta']['end'] and original['_meta']['exit_code'] == 1
assert original['metrics']['engineering_gate_passed'] is False
assert not (root / 'results' / (run + '.json')).exists()
assert not list((root / 'logs/runs').glob(run + '*'))
assert not list((root / 'logs/pbs').glob(run + '-*'))
assert not (Path('/scratch/e1583364/cvpr2027/g01_parallel') / run).exists()
old = json.loads(old_bytes)
assert old['parent_run_name'] == 'gen_test_s16_smoke_raw10_01'
plan = copy.deepcopy(old)
plan['parent_run_name'] = run
assert {k: v for k, v in plan.items() if k != 'parent_run_name'} == {
    k: v for k, v in old.items() if k != 'parent_run_name'}
smoke.validate_quota(plan, run)
path = root / 'configs' / (run + '_quota.json')
with path.open('xb') as stream:
    stream.write((json.dumps(plan, indent=2, sort_keys=True, allow_nan=False) + '\n').encode())
    stream.flush()
    os.fsync(stream.fileno())
path.chmod(0o444)
new_ref = {'file': str(path.relative_to(root)), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest()}
command = ['python3', '-u', '-m', smoke.MODULE, '--name', run, '--scene', 'FloorPlan21',
    '--quota-plan', new_ref['file'], '--quota-plan-sha256', new_ref['sha256'],
    '--timeout-seconds', '1000', '--sample-rejected-raw']
# Both are emitted for review only; neither is executed by this preparation.
submission = ['python3', 'scripts/pbs/submit_phase.py', '--task', 'T01', '--budget-group',
    'G01', '--name', run, '--gpus', '1', '--walltime', '00:17:10', '--', *command]
metrics = {'validated': True, 'new_quota_plan': new_ref, 'command': command,
    'submission_command': submission, 'scene_timeout_seconds': 600,
    'parent_timeout_seconds': 1000, 'pbs_wall_seconds': 1030,
    'formal_collection_eligible': False, 'old_engineering_gate_passed': False,
    'old_engineering_observations': copy.deepcopy(original['metrics']['engineering_observations']),
    'only_quota_field_changed': 'parent_run_name', 'gpu_submission_performed': False,
    'scope': 'Exact second engineering smoke; original native Teleport timeout remains a failure, never an ordinary scene boundary. No scientific quota or threshold change.'}
result = {'metrics': metrics, 'config': {'name': name, 'original_smoke_result': original_ref},
    'sources': [original_ref], 'artifact_references': [
        {'file': str(old_path.relative_to(root)), 'sha256': old_sha}, new_ref]}
with (root / 'results' / (name + '.json')).open('x') as stream:
    json.dump(result, stream, indent=2, allow_nan=False)
    stream.write('\n')
assert old_path.read_bytes() == old_bytes
assert hashlib.sha256(original_path.read_bytes()).hexdigest() == original_ref['sha256']
print('FINAL_METRICS_JSON: ' + json.dumps(metrics, sort_keys=True, allow_nan=False), flush=True)

