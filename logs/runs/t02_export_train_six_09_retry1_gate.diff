e']['run_name'] == gate_name and m['gate']['exit_code'] == 86\n                and not m['gate'].get('provenance_error') and m['gate']['result_path'] == 'results/' + gate_name + '.json',\n                'G01 gate wrapper is not the exact failed native gate')\n        gate_ref = m['gate']['source']\n        gate_timeout = c['gate_timeout_seconds']\n        mask, cpu = c['parent_cuda_visible_devices'], c['cpu_affinity']\n        checked_results = [outer_ref]\n\n    gate, audit_ref = logged(gate_name)\n    bind(gate_ref, gate, ROOT / 'results' / (gate_name + '.json'))\n    g, a, gm = gate['config'], gate['config']['allocation'], gate['metrics']\n    nodes = {part.split('/')[0] for part in fields['exec_host'].split('+')}\n    require(nodes == {c['node']} == {g['node']} == {outer['_meta']['host']} == {inner['_meta']['host']} == {gate['_meta']['host']},\n            'Actual PBS node does not match every producer and gate')\n    require(g['name'] == gate_name and g['pbs_jobid'] == job and a['pbs_jobid'] == job\n            and a['name'] == gate_name and a['cuda_visible_devices'] == mask and a['cuda_driver_uuids'] == [mask]\n            and a['cpu_affinity'] == cpu and len(cpu) == len(set(cpu)) == 12\n            and a['scratch'] == payload['environment']['CVPR_SCRATCH']\n            and g['resolution'] == 255 and g['segmentation'] is True\n            and g['timeout_seconds'] == gate_timeout, 'Native gate allocation/mask/CPU/scratch mismatch')\n    command = gate['_meta']['command']\n    gate_arguments = ['-u','-m','src.tools.render_gate','--name',gate_name,'--gpus','1',\n                      '--resolution','255','--segmentation','--timeout-seconds']\n    require(Path(command[0]).name == 'python3' and command[1:-1] == gate_arguments\n            and command[-1] in (str(float(gate_timeout)), str(int(gate_timeout))),\n            'Native gate command differs')\n    require(gate['_meta']['exit_code'] == 86 and gm['exit_code'] == 86 and gm['passed'] is False\n            and