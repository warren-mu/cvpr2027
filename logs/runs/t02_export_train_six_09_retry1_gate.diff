+      "\"\"\"One-off read-only guard for two exact native black-gate chains.\n\nRun inline only through run_logged + record_command. No qsub/qdel, result\nmutation, name normalization, live process inference, or synthetic payloads.\n\"\"\"\nimport io\nimport json\nfrom pathlib import Path\nimport shlex\nimport subprocess\nfrom PIL import Image\nfrom src.tools import phase_watch as watch\n\nROOT = Path.cwd().resolve()\nauditor = watch.load_module('oneoff_black_auditor', ROOT / 'scripts/audit_provenance.py')\n\n\ndef require(value, reason):\n    if not value:\n        raise ValueError(reason)\n\n\ndef logged(name):\n    return watch.load_logged(ROOT, ROOT / 'results' / (name + '.json'), auditor)\n\n\ndef reference(path):\n    path = Path(path).resolve()\n    return {'file': str(path.relative_to(ROOT)), 'sha256': watch.digest(path), 'bytes': path.stat().st_size}\n\n\ndef bind(ref, data, path):\n    require(ref['file'] == str(path.relative_to(ROOT)) and ref['sha256'] == watch.digest(path)\n            and ref['metrics_sha256'] == data['_meta']['metrics_sha256']\n            and ref['exit_code'] == data['_meta']['exit_code'], 'Original nested result reference differs')\n\n\ndef validate(job, name, receipt_dir, accounting_name, inner_name=None):\n    directory = (ROOT / 'logs/pbs' / receipt_dir).resolve()\n    pp, sp, rp = directory / 'payload.json', directory / 'job.pbs', directory / 'submission.json'\n    payload, receipt = json.loads(pp.read_text()), json.loads(rp.read_text())\n    outer, outer_ref = logged(name)\n    account, account_ref = logged(accounting_name)\n    require(account['_meta']['exit_code'] == 0 and account['metrics']['complete_allocation_accounting'] is True\n            and account['config']['errors'] == [], 'Accounting not complete')\n    ac = account['_meta']['command']\n    require(ac == ['python3', 'src/tools/pbs_usage.py', '--name', accounting_name, job],\n            'Require the exact canonical logged PBS accounting command')\n    account_log = (ROOT / account['_meta']['log_path']).read_text()\n    require(json.dumps(account['config'], indent=2) in account_log, 'PBS config absent from authenticated original log')\n    entries = [row for row in account['config']['jobs'] if row['job_id'] == job]\n    require(len(entries) == 1 and entries[0]['qstat_exit'] == 0, 'PBS job missing/ambiguous')\n    fields = entries[0]['fields']\n    require(fields['project'] == 'CFP04-SF-125' and fields['job_state'] == 'F'\n            and fields['Exit_status'] == '86' and fields['run_count'] == '1'\n            and fields['Job_Owner'].split('@')[0] == 'e1583364', 'Not this owned terminal black-only job')\n    require(payload['repo'] == str(ROOT) and payload['name'] == name and payload['task_id'] == 'T01'\n            and payload['queue'] == 'autox' and payload['requested_host'] == 'hopper-22'\n            and payload['requested_gpu_count'] == 1 and payload['dry_run'] is False,\n            'Original immutable allocation differs')\n    from src.tools.pbs_black_retry import validate_payload_host\n    pinned = validate_payload_host(ROOT, payload)\n    require(pinned['requested_host'] == 'hopper-22' and pinned['rotation_index'] == 0, 'Original pinned host authorization differs')\n    require({part.split('/')[0] for part in fields['exec_host'].split('+')} == {'hopper-22'}, 'Actual allocation differs from approved original host')\n    require(pp.stat().st_mode & 0o222 == 0 and sp.stat().st_mode & 0o222 == 0, 'Original payload/script is not immutable')\n    require(receipt['returncode'] == 0 and receipt['stdout'].strip() == job and not receipt['stderr'],\n            'Receipt does not prove one successful submission of the exact job')\n    wall = fields['Resource_List.walltime']\n    h, m, s = map(int, wall.split(':'))\n    require(h * 3600 + m * 60 + s == payload['requested_wall_seconds']\n            and fields['Resource_List.ngpus'] == '1' and fields['Resource_List.ncpus'] == '12'\n            and fields['queue'] == 'smallx' and 'PBS_O_QUEUE=autox' in fields['Variable_List']\n            and float(fields['Resource_List.queue_charge_rate']) == payload['requested_queue_charge_rate'],\n            'PBS resources/router/charge differ from original payload')\n    expected_qsub = ['qsub', '-N', fields['Job_Name'], '-l', 'walltime=' + wall,\n                     '-o', str(directory / 'pbs.out'), str(sp)]\n    require(receipt['command'] == expected_qsub\n            and shlex.split(fields['Submit_arguments']) == expected_qsub[1:]\n            and fields['Output_Path'].split(':', 1)[1] == str(directory / 'pbs.out'),\n            'Receipt/PBS exact argv or output binding differs')\n    template = subprocess.check_output(['git', 'show', outer['_meta']['git_commit'] + ':scripts/pbs/job_1gpu.pbs'], text=True)\n    require(template.count('@@CVPR_PAYLOAD@@') == 1\n            and '#PBS -P CFP04-SF-125\\n' in template and '#PBS -q autox\\n' in template\n            and '#PBS -l select=1:ngpus=1\\n' in template\n            and sp.read_text() == template.replace('#PBS -l select=1:ngpus=1\\n', '#PBS -l select=1:ngpus=1:host=hopper-22\\n').replace('@@CVPR_PAYLOAD@@', shlex.quote(str(pp))),\n            'Job script differs from the committed one-GPU template and exact original payload path')\n    require(outer['_meta']['name'] == name and outer['_meta']['command'] == payload['command']\n            and outer['_meta']['exit_code'] == 86, 'Outer result is not the exact immutable PBS command')\n    for other in (ROOT / 'logs/pbs').glob('*/payload.json'):\n        require(json.loads(other.read_text()).get('retry_of') != job, 'A retry payload already exists; do not duplicate')\n\n    if inner_name is not None:\n        inner, inner_ref = logged(inner_name)\n        nested = outer['config']['command']\n        require(payload['budget_group'] == 'T01v2' and outer['config']['pbs_job_id'] == job\n                and outer['metrics']['command_exit_code'] == 86 and outer.get('error') is None\n                and payload['command'] == ['python3','-u','-m','src.tools.record_command','--name',name,'--',*nested],\n                'T02 outer is not its actual record_command wrapper')\n        require(nested == ['python3','-u','scripts/run_logged.py','--name',inner_name,'--seed','0','--',*inner['_meta']['command']],\n                'Original nested run_logged command does not bind the actual inner result')\n        argv = inner['_meta']['command']\n        require(argv[:6] == ['python3','-u','-m','src.tools.t02_export','--name',inner_name], 'Wrong T02 inner producer')\n        c, m = inner['config'], inner['metrics']\n        expected = ['python3','-u','-m','src.tools.t02_export','--name',inner_name,'--source',c['source']]\n        for pair in c['pair_id']: expected.extend(['--pair-id',pair])\n        expected += ['--timeout-seconds','2280','--pair-timeout-seconds','300','--gate-timeout-seconds','180']\n        require(argv == expected and c['timeout_seconds'] == 2280 and c['pair_timeout_seconds'] == 300\n                and c['version'] == 't02_single_gpu_export_v1' and c['gpus'] == 1 and c['depth'] == 4\n                and c['resolution'] == 255 and c['pbs_jobid'] == job and c['name'] == inner_name,\n                'T02 config/argv/allocation differs')\n        require(inner['_meta']['exit_code'] == 86 and m['producer_exit_code'] == 86\n                and m['kind'] == 't02_table_export' and m['status'] == 'blocked_by_render_gate'\n                and m['black_frame_detected'] is True and m['errors'] == [] and m['cleanup_errors'] == []\n                and m['pairs'] == [] and m['unstarted_pair_ids'] == c['pair_id']\n                and m['export_checks_complete'] is False and m['downstream_allowed'] is False,\n                'T02 is not a clean pre-export black-gate stop')\n        gate_name = inner_name + '_gate'\n        gate_ref = m['gate']\n        gate_timeout = c['gate_timeout_seconds']\n        mask, cpu = c['cuda_visible_devices'], c['cpu_affinity']\n        checked_results = [outer_ref, inner_ref]\n    else:\n        inner, inner_ref = outer, outer_ref\n        c, m = outer['config'], outer['metrics']\n        argv = payload['command']\n        require(payload['budget_group'] == 'G01' and argv[:6] == ['python3','-u','-m','src.tools.g01_collect_parallel','--name',name]\n                and c['collection_version'] == 'g01_single_stage_collection_v1' and c['gpus'] == 1\n                and c['pbs_jobid'] == job and c['name'] == name and c['stage_plans'] == [], 'Not the original G01 native collection entry')\n        expected = ['python3','-u','-m','src.tools.g01_collect_parallel','--name',name,'--scenes',*c['scenes'],\n                    '--concurrency','6','--benchmark-source',c['benchmark_source'],'--timeout-seconds',str(expected_timeout),'--partition','test',\n                    '--quota-plan', old_plan_ref['file'], '--quota-plan-sha256', old_plan_ref['sha256']]\n        require(argv == expected and c['concurrencies'] == [6] and c['timeout_seconds'] == expected_timeout\n                and c.get('g01_partition') == 'test' and c.get('per_scene_class_cap') == 6\n                and c['submission']['file'] == str(pp.relative_to(ROOT)) and c['submission']['sha256'] == watch.digest(pp),\n                'G01 original command/submission identity differs')\n        require(m['kind'] == 'g01_parallel_collection' and m['status'] == 'blocked_by_render_gate'\n                and m['exit_code'] == 86 and m['black_frame_detected'] is True and m['cleanup_errors'] == []\n                and m['scene_runs'] == [] and m['started_shards'] == [] and m['stages'] == []\n                and m['admission_final'] == [] and m['unfinished_run_names'] == [] and m['stop_reasons'] == []\n                and not m.get('error') and not m.get('errors') and m['acceptance_passed'] is False,\n                'G01 has work/non-black errors or uncertain cleanup')\n        gate_name = name + '_j' + job.replace('.', '_').replace('-', '_') + '_gate'\n        require(m['gate']['run_name'] == gate_name and m['gate']['exit_code'] == 86\n                and not m['gate'].get('provenance_error') and m['gate']['result_path'] == 'results/' + gate_name + '.json',\n                'G01 gate wrapper is not the exact failed native gate')\n        gate_ref = m['gate']['source']\n        gate_timeout = c['gate_timeout_seconds']\n        mask, cpu = c['parent_cuda_visible_devices'], c['cpu_affinity']\n        checked_results = [outer_ref]\n\n    gate, audit_ref = logged(gate_name)\n    bind(gate_ref, gate, ROOT / 'results' / (gate_name + '.json'))\n    g, a, gm = gate['config'], gate['config']['allocation'], gate['metrics']\n    nodes = {part.split('/')[0] for part in fields['exec_host'].split('+')}\n    require(nodes == {c['node']} == {g['node']} == {outer['_meta']['host']} == {inner['_meta']['host']} == {gate['_meta']['host']},\n            'Actual PBS node does not match every producer and gate')\n    require(g['name'] == gate_name and g['pbs_jobid'] == job and a['pbs_jobid'] == job\n            and a['name'] == gate_name and a['cuda_visible_devices'] == mask and a['cuda_driver_uuids'] == [mask]\n            and a['cpu_affinity'] == cpu and len(cpu) == len(set(cpu)) == 12\n            and a['scratch'] == payload['environment']['CVPR_SCRATCH']\n            and g['resolution'] == 255 and g['segmentation'] is True\n            and g['timeout_seconds'] == gate_timeout, 'Native gate allocation/mask/CPU/scratch mismatch')\n    command = gate['_meta']['command']\n    gate_arguments = ['-u','-m','src.tools.render_gate','--name',gate_name,'--gpus','1',\n                      '--resolution','255','--segmentation','--timeout-seconds']\n    require(Path(command[0]).name == 'python3' and command[1:-1] == gate_arguments\n            and command[-1] in (str(float(gate_timeout)), str(int(gate_timeout))),\n            'Native gate command differs')\n    require(gate['_meta']['exit_code'] == 86 and gm['exit_code'] == 86 and gm['passed'] is False\n            and gm['black_frame_detected'] is True and gm['errors'] == [] and gm['cleanup_errors'] == []\n            and gm['expected_gpu_count'] == gm['completed_gpu_count'] == 1\n            and len(gm['devices']) == len(a['devices']) == 1, 'Gate is not a complete clean one-GPU black stop')\n    device, row = a['devices'][0], gm['devices'][0]\n    obs = row['observation']\n    require(device['logical_index'] == 0 and device['gpu_uuid'] == mask and row['worker_error'] is None\n            and obs['gpu_identity'] == device and obs['node'] == c['node']\n            and not obs.get('error') and not obs.get('cleanup_error')\n            and [capture['stage'] for capture in obs['captures']] == ['after_constructor','after_Pass']\n            and any(packet['stage'] == 'Pass' and packet['fresh_main_rgb_payloads'] > 0\n                    and packet['cached_metadata'] is False for packet in obs['wire_packets']),\n            'Worker/native identity, actual fresh Pass RGB, or cleanup missing')\n    images = []\n    for capture in obs['captures']:\n        require(capture['valid_shape'] is True and capture['shape'] == [255,255,3] and capture['dtype'] == 'uint8'\n                and capture['action_success'] is True and not capture['error_message']\n                and capture['black'] is True and capture['nonzero_rgb_values'] == capture['min_rgb'] == capture['max_rgb'] == 0,\n                'Not the complete original successful-action full-zero capture')\n        path = Path(capture['png']['path']).resolve()\n        require(path.parent == ROOT / 'logs/runs' / gate_name / 'render_gate'\n                and watch.digest(path) == capture['png']['sha256'], 'Black PNG missing or SHA/path mismatch')\n        with Image.open(io.BytesIO(path.read_bytes())) as image:\n            require(image.mode == 'RGB' and image.size == (255,255) and image.getextrema() == ((0,0),)*3,\n                    'Decoded native PNG is not a full all-zero RGB image')\n        images.append(reference(path))\n    re