 if not relevant:continue
 d,r=audited_result(path);sources.append(r);assert d['_meta']['exit_code']==0 and d['metrics']['complete_allocation_accounting']
 assert d['_meta']['command'][1]=='src/tools/pbs_usage.py'
 for j in relevant:
