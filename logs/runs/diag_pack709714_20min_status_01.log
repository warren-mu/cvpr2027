 raw=path.read_bytes();d=json.loads(raw);row['sha256']=hashlib.sha256(raw).hexdigest();row['lifecycle']={k:d.get('_meta',{}).get(k) for k in ('start','end','exit_code')};m=d.get('metrics',{})
