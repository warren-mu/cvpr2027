 record['query']={'command':command,'exit_code':p.returncode,'stdout':p.stdout,'stderr':p.stderr,'timed_out':False}
 if p.returncode==0:
  d=json.loads(p.stdout);record['original_fields']={job:{k:v.get(k) for k in ('job_state','qtime','etime','stime','run_count','Exit_status','exec_host','exec_vnode','resources_used')} for job,v in d.get('Jobs',{}).items()}
