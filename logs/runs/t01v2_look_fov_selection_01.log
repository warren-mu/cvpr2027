sources=[]; rows=[]; totals={v:{k:0 for k in ('direct_flip','direct_stay','look_flip','look_stay')} for v in (100,60)}
for camera,scene,source_name in entries:
 d,ref=audited_result(root/'results'/(source_name+'.json'))
 m=d['metrics']
 if d['_meta']['exit_code']!=0 or m['errors'] or m['status'] not in ('checkpoint_ready_for_human_review','checkpoint_no_qualified_pairs'):raise ValueError('Unverified source')
 if len(m['source_runs'])!=1 or m['source_runs'][0]['scene']!='FloorPlan'+str(scene):raise ValueError('Wrong source scene')
 recorded=m['source_runs'][0]['source']['file']
 actual,actual_ref=audited_result(root/recorded)
 if actual['config']['field_of_view']!=camera or actual['config']['scene']!='FloorPlan'+str(scene):raise ValueError('Wrong source camera')
 counts=m['independently_verified_by_class']
 if m['published_pair_count']!=sum(counts.values()):raise ValueError('Checkpoint count mismatch')
 for kind,count in counts.items():
  if type(count)is not int or count<0:raise ValueError('Invalid count')
  totals[camera][kind]+=count
 sources.extend([ref,actual_ref])
 rows.append({'field_of_view':camera,'scene':'FloorPlan'+str(scene),'attempts':m['observed_attempts'],'counts':counts,'checkpoint':ref['file'],'funnel':'logs/review/diag_look_funnel'+str(camera)+'_fp'+str(scene)+'_01.md'})
def rank(camera):
 c=totals[camera];return(c['look_flip']+c['look_stay'],c['direct_flip']+c['direct_stay'],int(camera==100))
