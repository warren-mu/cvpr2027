config={'approved_selection_rule':'tasks/T01v2.md supplements10,13','future_collection_field_of_view':selected,'same_scenes':['FloorPlan203','FloorPlan204','FloorPlan10'],'thresholds_modified':False,'seed_changed':False,'existing_evidence_rewritten':False}
