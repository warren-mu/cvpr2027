 counts[status]+=1;kinds[status][p["kind"]]+=1;scenes[(status,p["kind"])].add(p["scene"])
 rows.append({"pair_id":p["pair_id"],"scene":p["scene"],"kind":p["kind"],"status":status,"source":ref,"pair_reference":sr["pair_reference"],"configuration_id":sr["configuration"]["configuration_id"],"table_manifest":p.get("table_manifest"),"error":p.get("error"),"rejection_reasons":p.get("rejection_reasons"),"export_checks_complete":m["export_checks_complete"],"cache_matches_live":m["cache_matches_live"],"downstream_allowed":m["downstream_allowed"]})
