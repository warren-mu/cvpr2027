report={"scope":"Exact original selected05 export outcomes only. This does not run or certify cache_matches_live, does not freeze a test pool, and does not remove errors or reset claim keys.","selection":{"file":str(selection_path),"sha256":selection_sha},"selected_denominator":sel["selected_count"],"status_counts":dict(counts),"counts_by_status_and_kind":{k:dict(v) for k,v in kinds.items()},"scene_counts_by_status_and_kind":{s:{k:len(v) for (s2,k),v in scenes.items() if s2==s} for s in counts},"successful_source_files":[r["source"]["file"] for r in rows if r["status"]=="exported"],"outcomes":rows,"cache_matches_live":None,"downstream_allowed":False}
