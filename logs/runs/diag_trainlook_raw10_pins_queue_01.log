from zoneinfo import ZoneInfo
jobs=['710213.hopper-m-02','710282.hopper-m-02']
ok=False
for attempt in (1,2):
 print('QUERY_ATTEMPT',attempt,datetime.datetime.now(datetime.timezone.utc).isoformat(),flush=True)
 try:
  p=subprocess.run(['/cm/shared/apps/pbspro/current/bin/qstat','-fx',*jobs],capture_output=True,text=True,timeout=30)
 except subprocess.TimeoutExpired as error:
  print('QUERY_TIMEOUT',str(error),flush=True)
  for value in (error.stdout,error.stderr):
   if value: print(value.decode(errors='replace') if isinstance(value,bytes) else value,flush=True)
  continue
 print(p.stdout,end='',flush=True);print(p.stderr,end='',flush=True)
 rows=[]
 for match in re.finditer(r'^Job Id: (\S+)\n(.*?)(?=^Job Id: |\Z)',p.stdout,re.M|re.S):
  job,body=match.groups(); row={'job_id':job}
  for key in ('job_state','qtime','stime','run_count','exec_host','queue','resources_used.walltime'):
   m=re.search(r'^\s*'+re.escape(key)+r' = (.*)$',body,re.M);row[key]=m.group(1) if m else None
  if row['qtime']:
   t=datetime.datetime.strptime(row['qtime'],'%a %b %d %H:%M:%S %Y').replace(tzinfo=ZoneInfo('Asia/Singapore'))
   row['qtime_utc']=t.astimezone(datetime.timezone.utc).isoformat()
   row['q20_deadline_utc']=(t+datetime.timedelta(seconds=1200)).astimezone(datetime.timezone.utc).isoformat()
  rows.append(row)
 print('PIN_QUEUE_TIMING_JSON: '+json.dumps({'attempt':attempt,'qstat_exit':p.returncode,'rows':rows,'scope':'Read-only; no qdel/qsub; qtime timezone original Asia/Singapore'},sort_keys=True),flush=True)
 if p.returncode==0 and {row['job_id'] for row in rows}==set(jobs):ok=True;break
raise SystemExit(0 if ok else 1)

