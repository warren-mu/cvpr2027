 assert p.resolve()==p and str(p).startswith('/scratch/e1583364/') and s.st_uid==os.getuid()==r['uid'] and stat.S_ISREG(s.st_mode) and s.st_nlink==1
 assert (s.st_ino,s.st_mtime_ns,s.st_size,s.st_dev,s.st_blocks*512)==(r['inode'],r['mtime_ns'],r['bytes'],r['device'],r['allocated_bytes'])
