name=sys.argv[1]; parents=sys.argv[2:]
plan=json.loads((ROOT/'configs/g01_test40_initial.json').read_text());units={u['name']:u for u in plan['units']}
directory=ROOT/'logs/runs'/name/'evidence';directory.mkdir(parents=True,exist_ok=False)
rows=[]
for parent in parents:
