result={'config':{'name':name,'parents':parents,'snapshot_cap_per_source_bytes':8*1024*1024},'metrics':metrics}
with (ROOT/'results'/(name+'.json')).open('x') as f:json.dump(result,f,indent=2);f.write('\n')
p=ROOT/'STATUS.md';summary=[]
for r in rows:
 if r['observed_counts'] is not None:summary.append(r['run_name']+': '+json.dumps(r['observed_counts']['observed_reported_passed_by_class'],sort_keys=True)+'; observed attempts='+str(r['observed_counts']['observed_complete_attempts'])+('; ended' if r['ended'] else '; running snapshot'))
p.write_text(p.read_text()+'\n\n## '+datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')+' — 测试生成运行中计数\n\n'+('\n'.join(summary) if summary else '尚未观察到完整尝试行；不是零产出结论。')+'\n\n以上为归档日志完整前缀中的生成端计数，尚未独立验收；见 '+name+'。\n')
