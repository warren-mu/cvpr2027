  row={'run_name':child,'scene':scene,'observed_counts':None,'ended':False,'scientific_acceptance':None}
  final=ROOT/'results'/(child+'.json')
  if final.exists():
   data=json.loads(final.read_text());row.update(ended=bool(data.get('_meta',{}).get('end')),status=data.get('metrics',{}).get('status'),scene_excluded=data.get('metrics',{}).get('scene_excluded'))
