ain", "--quota-plan", "configs/gen_train_look_first_unit_01_quota.json", "--quota-plan-sha256", "da366045a7b5cb060f85210852e53286b80b09f4417d00f960f68ce768427cd2", "--nearby-physics", "--sample-rejected-raw"], "original_job_script": {"file": "logs/pbs/gen_train_look_first_unit_01-20261110T090456Z-e9bc210a/job.pbs", "sha256": "e3185c8b42f9272c7c7e2d1fba4efb5e0b0c2b33562309d844e5acf2661fecff"}, "original_payload": {"file": "logs/pbs/gen_train_look_first_unit_01-20261110T090456Z-e9bc210a/payload.json", "sha256": "db5a8d3efd59d9dd6dee02701a5236cce3911a714465991f343644f404f255c9"}, "original_receipt": {"file": "logs/pbs/gen_train_look_first_unit_01-20261110T090456Z-e9bc210a/submission.json", "sha256": "8bac354090e2d3945b6cf1b1be32b444994b0f93e9f7f0b523ee6876a3c4bc9a"}, "pbs_accounting": {"file": "results/g01_train_look_first_unit_final_accounting_02.json", "metrics_sha256": "6747043282aba7bbf1c73f6a12038f6ecfb5dcba817e2e00336a4bd18cf2f248", "sha256": "4c22b5ec37293bca381ab7a2efd5d4e1164cbd6414f0d65a7ac3970be285eb16"}, "source_results": [{"file": "results/gen_train_look_first_unit_01.json", "metrics_sha256": "cd18d953e3971352b65557dd1a070a7f865ee7bc43d9f5e683248c98e76d6d7c", "sha256": "f1e5adb0d870c1f031153c7363bf2827b68be077bff80861aadf8f203cd8897e"}, {"file": "results/gen_train_look_first_unit_01_j710105_hopper_m_02_gate.json", "metrics_sha256": "e24235d448facab28608a6d652fb375c489a16ff2dae2f7ac0ab61972f73af1e", "sha256": "01ad405fddbfe665df31c03e752f010feb3dc0e787252606dc96351708700194"}]}, "technical_retry_plan_ready": true}
