def read(path,ref=None):
 p=Path(path);assert p.stat().st_size<16*1024*1024
 raw=p.read_bytes();sha=hashlib.sha256(raw).hexdigest()
 if ref is not None:assert sha==ref['sha256']
 return json.loads(raw),{'file':str(p),'sha256':sha,'bytes':len(raw)}
