      "-c",
      "from pathlib import Path\nimport json,traceback\nfrom src.tools import t02_export_parallel as original\nfrom src.tools.t01_partition import audited_result\nROOT=Path.cwd();name=\"diag_t02_train_six_02_completed_summary_01\";parent_name=\"t02_export_train_six_02_retry2\"\nmetrics={\"status\":\"failed\",\"complete_by_kind\":{k:0 for k in (\"direct_flip\",\"direct_stay\",\"look_flip\",\"look_stay\")},\"unknown_or_rejected_by_kind\":{k:0 for k in (\"direct_flip\",\"direct_stay\",\"look_flip\",\"look_stay\")},\"units\":[],\"errors\":[],\"cache_authorized\":False,\"full_T02_acceptance\":None,\"scope\":\"Original completed child outcomes and allocation/source identity rechecked; no new raw scientific rerun or formal cache certificate.\"}\nsources=[];exit_code=1\ntry:\n parent,pref=audited_result(ROOT/\"results\"/(parent_name+\".json\"));sources.append(pref)\n cfg,pm=parent[\"config\"],parent[\"metrics\"]\n assert parent[\"_meta\"][\"end\"] and parent[\"_meta\"][\"exit_code\"]==0 and pm[\"status\"]==\"original_exports_completed_cache_pending\"\n assert pm[\"cleanup_errors\"]==[] and pm[\"errors\"]==[] and pm[\"all_units_ended\"] is True and pm[\"unstarted_unit_indices\"]==[]\n manifest,mref=original.read_manifest(Path(cfg[\"manifest\"]),cfg[\"manifest_sha256\"])\n assert manifest[\"entries\"]==cfg[\"planned_units\"] and len(pm[\"units\"])==len(manifest[\"entries\"])==6\n for index,(unit,entry) in enumerate(zip(pm[\"units\"],manifest[\"entries\"])):\n  assert unit[\"unit_index\"]==index and unit[\"entry\"]==entry\n  child,cref=audited_result(ROOT/unit[\"result_path\"])\n  assert all(unit[\"source\"][k]==cref[k] for k in (\"file\",\"sha256\",\"metrics_sha256\",\"git_commit\"))\n  command=original.unit_command(parent_name+\"_u\"+str(index).zfill(4),entry,cfg[\"unit_timeout_seconds\"],cfg[\"pair_timeout_seconds\"],cfg[\"gate_timeout_seconds\"])\n  out=original.child_outcome(unit,child,cfg,command,entry)\n  sources.append(cref);rows=out[\"original_pairs\"];assert len(rows)==1\n  row=rows[0];assert row[\"kind\"]==entry[\"kind\"]\n  usable=(out[\"export_checks_complete\"] is True and row[\"status\"]==\"exported\" and row[\"native_evidence_verified\"] is True and row[\"pair_checks_passed\"] is True and row[\"table_complete\"] is True)\n  metrics[\"complete_by_kind\" if usable else \"unknown_or_rejected_by_kind\"][entry[\"kind\"]]+=1\n  measured=row.get(\"export_measurements\") or {}\n  metrics[\"units\"].append({\"unit_index\":index,\"source\":cref,\"pair_id\":entry[\"pair_id\"],\"dataset_key\":entry[\"dataset_key\"],\"kind\":entry[\"kind\"],\"usable_export_cache_pending\":usable,\"original_status\":row[\"status\"],\"rejection_reasons\":row.get(\"rejection_reasons\"),\"errors\":out[\"errors\"],\"cleanup_errors\":out[\"cleanup_errors\"],\"state_count\":measured.get(\"state_count\"),\"shadow_divergent_states\":row.get(\"shadow_divergent_states\"),\"in_clean_subset\":row.get(\"in_clean_subset\"),\"worker_elapsed_seconds\":row.get(\"worker_elapsed_seconds\"),\"render_elapsed_seconds\":measured.get(\"elapsed_seconds\"),\"table_manifest\":row.get(\"table_manifest\")})\n metrics.update(status=\"original_terminal_outcomes_bound\",pbs_jobid=cfg[\"pbs_jobid\"],node=cfg[\"node\"],gpu_uuid=cfg[\"cuda_visible_devices\"],fixed_manifest=mref,cache_source_results=[row[\"source\"][\"file\"] for row in metrics[\"units\"] if row[\"usable_export_cache_pending\"]])\n exit_code=0\nexcept BaseException as error:\n traceback.print_exc();metrics[\"errors\"].append(type(error).__name__+\": \"+str(error))\nmetrics[\"producer_exit_code\"]=exit_code\noutput=ROOT/\"results\"/(name+\".json\")\nwith output.open(\"x\") as stream:\n json.dump({\"metrics\":metrics,\"config\":{\"name\":name,\"parent\":parent_name,\"scope\":metrics[\"scope\"]},\"sources\":sources},stream,indent=2,allow_nan=False);stream.write(\"\\n\")\nprint(\"FINAL_METRICS_JSON: \"+json.dumps(metrics,sort_keys=True,allow_nan=False))\nraise SystemExit(exit_code)\n"
