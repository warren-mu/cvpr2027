=len(set(identity['cpu_affinity']))==12\n rows=[];proofs=[]\n for record,entry in zip(units,entries):\n  child,cref=load(record['source']['file']);assert all(cref[k]==record['source'][k] for k in ['file','sha256','metrics_sha256'])\n  assert record['entry']==entry and record.get('authentication_error') is None and record.get('provenance_error') is None\n  outcome=parallel.child_outcome(record,child,identity,record['command'],entry)\n  assert all(record[k]==v for k,v in outcome.items())\n  assert outcome['export_checks_complete'] is True and outcome['cleanup_errors']==outcome['errors']==outcome['original_unstarted_pair_ids']==[]\n  assert '--sample-rejected-raw' in record['command']\n  for row in outcome['original_pairs']:\n   decision=row['raw_retention'];owner=raw.read(decision['owner_reference'])\n   assert owner['policy']==decision['policy']==raw.POLICY and owner['selection']==decision['draw']==raw.selection(owner['identity'])\n   assert owner['identity']['run_name']==child['config']['name'] and owner['identity']['pbs_jobid']==identity['pbs_jobid'] and owner['identity']['pair_id']==row['pair_id']\n   assert owner['identity']['source_pair']==entry['pair']\n   assert decision['scientific_status_unchanged']==row['status'] and decision['cleanup_confirmed'] is True\n   assert not decision.get('retention_error') and not decision.get('report_write_error')\n   if row['status']=='exported':\n    assert decision['binary_payloads_retained'] is True and decision['omitted_payload_count']==decision['omitted_payload_bytes']==0 and decision['eligible_scientific_rejection'] is False\n    assert row['native_evidence_verified'] is True and row['pair_checks_passed'] is True and row['table_complete'] is True\n    assert all(isinstance(row.get(k),dict) for k in ['raw_index','raw_incremental_index','table_manifest','detail','report_reference'])\n   else:assert row['status']=='rejected' and row['rejection_reasons']\n   assert row.get('cache_matches_live') is None and row.get('downstream